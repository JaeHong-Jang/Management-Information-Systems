    { "id": "absolute-refund", "pattern": "무조건\\s*(환불|교환|무료)", "why": "보상 범위를 단정하면 정산·규정 문제가 생긴다" },
    { "id": "free-promise", "pattern": "(공짜|무료)로\\s*(드리|줘|준다)", "why": "임의 무료 제공은 점장 승인 대상이다" },
    { "id": "always-never", "pattern": "(항상|절대로)\\s*(된다|됩니다|안 된다|안됩니다)", "why": "예외를 지우는 단정은 판단을 막는다. 조건을 함께 적는다" },
    { "id": "ai-certainty", "pattern": "(100%|확실히|틀림없이)", "why": "AI 답이 확실하다고 말하지 않는다" },
    { "id": "hide-from-manager", "pattern": "(점장|사장)(님)?(한테|에게|께)\\s*(말하지|알리지)\\s*(마|말)", "why": "보고를 막는 지시는 남기지 않는다" }
