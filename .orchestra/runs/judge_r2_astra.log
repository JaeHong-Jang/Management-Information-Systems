// 답변팀: 검색 사서 → 현장 코치 → (검증팀) → 점장 연결
import { z } from 'zod';
import type { Card } from '@shared/contracts';
import { ask, llmEnabled } from '../harness/llm.js';
import { llmOr, type StepOut } from '../harness/runner.js';
import { containment, search, tokens, type Hit } from '../tools/search.js';

export interface Answer {
  answer: string;
  why: string;
  cited: string[];
  confidence: 'high' | 'low' | 'none';
  needsManager: boolean;
}

// ---------- 검색 사서 (규칙) ----------

export function librarian(question: string, cards: Card[], excluded: { id: string; why: string }[] = []): StepOut<Hit[]> {
  const hits = search(question, cards);
  const skip = excluded.length ? ` · 만료·상충 카드 ${excluded.length}개는 근거에서 뺐습니다(${excluded.map((e) => `${e.id} ${e.why}`).join(', ')})` : '';
  return {
    out: hits,
    summary: (hits.length ? `가까운 사례 ${hits.length}개: ${hits.slice(0, 3).map((h) => `${h.card.id}(${h.score.toFixed(1)})`).join(', ')}` : '가까운 사례를 찾지 못했습니다') + skip,
  };
}

// ---------- 현장 코치 ----------

const NO_ANSWER = '매장 위키에 이 상황에 맞는 사례가 아직 없습니다. 점장님께 질문을 넘겼어요. 답이 오면 위키에 사례로 추가됩니다.';

export function answerByRules(hits: Hit[]): Answer {
  const top = hits[0];
  if (!top || top.score < 3 || top.coverage < 0.25) return { answer: NO_ANSWER, why: '', cited: [], confidence: 'none', needsManager: true };
  // 같은 상황을 다룬 공식규정 카드가 비슷한 점수로 있으면 그쪽을 앞세운다.
  const official = hits.find((h) => h.card.source === '공식규정' && h.card.topic === top.card.topic && h.score >= top.score * 0.8);
  const ordered = official && official !== top ? [official, ...hits.filter((h) => h !== official)] : hits;
  const c = ordered[0].card;
  const lines = [`${c.title} [${c.id}]`, ...c.actions.map((a, i) => `${i + 1}. ${a} [${c.id}]`)];
  if (c.avoid) lines.push(`하지 말 것: ${c.avoid} [${c.id}]`);
  if (c.escalateWhen) lines.push(`점장 호출: ${c.escalateWhen} [${c.id}]`);
  const other = ordered.slice(1).find((h) => h.card.topic === c.topic && h.card.source !== c.source && h.score > top.score * 0.6);
  const cited = [c.id];
  if (other) {
    lines.push(`같은 토픽의 ${other.card.source} 카드 [${other.card.id}]도 있습니다. 내용이 다르면 공식규정을 따르세요.`);
    cited.push(other.card.id);
  }
  return { answer: lines.join('\n'), why: c.reason, cited, confidence: top.score > 6 ? 'high' : 'low', needsManager: false };
}

export async function coach(question: string, hits: Hit[]): Promise<StepOut<Answer>> {
  const context = hits
    .map(({ card: c }) => `[${c.id}] (${c.source}, 갱신 ${c.updated}) ${c.title}\n상황: ${c.situation}\n판단 이유: ${c.reason}\n대응: ${c.actions.join(' / ')}\n하면 안 되는 것: ${c.avoid || '-'}\n점장 호출 기준: ${c.escalateWhen || '-'}`)
    .join('\n\n');
  const schema = z.object({
    answer: z.string().describe('신입이 지금 바로 따라 할 3~5줄. 줄마다 끝에 근거 카드 [Cxxx]'),
    why: z.string().describe('이렇게 하는 이유 한두 문장(카드의 판단 이유에서)'),
    cited: z.array(z.string()),
    confidence: z.enum(['high', 'low', 'none']),
    needsManager: z.boolean(),
  });
  const { value, via } = await llmOr(
    () =>
      hits.length
        ? ask('coach', {
            user: `[사례 카드]\n${context}\n\n[신입의 질문]\n${question}\n\n카드에 있는 내용만 근거로 답하라. 카드에 없는 정책·금액·절차를 추측하지 마라. 공식규정과 현장노하우가 부딪히면 공식규정을 따르라고 적어라. 카드로 답할 수 없으면 confidence는 none, needsManager는 true.`,
            schema,
            effort: 'medium',
          })
        : Promise.resolve({ answer: NO_ANSWER, why: '', cited: [], confidence: 'none' as const, needsManager: true }),
    () => answerByRules(hits),
    llmEnabled(),
  );
  return { out: value, via, summary: value.needsManager ? '카드로 답할 수 없다고 판단' : `답변 작성 (근거 ${value.cited.join(', ')}, 확신 ${value.confidence})` };
}

// ---------- 점장 연결 (규칙) ----------

// 호출 기준 문장의 흔한 말(조건 연결어 등)은 일치로 세지 않는다
const COMMON = new Set(['있거', '거나', '이상', '하거', '고객', '손님', '경우', '해요', '하면', '면서', '요구', '구할', '언급', '급할']);

/** 질문이 카드의 점장 호출 기준에 해당하는가: 핵심 2-gram이 2개 이상 겹치거나, 기준 문장의 35% 이상이 질문에 들어 있다 */
export function matchesCondition(condition: string, question: string): boolean {
  const q = new Set(tokens(question));
  const shared = new Set(tokens(condition).filter((t) => t.length === 2 && !COMMON.has(t) && q.has(t)));
  return shared.size >= 2 || containment(condition, question) >= 0.35;
}

export interface Escalation { escalate: boolean; why: 'none' | 'no-evidence' | 'gate' | 'call'; callCard?: Card }

/** 넘기는 조건: 근거 카드 없음 / 검증을 통과한 근거 줄이 남지 않음 / 카드의 점장 호출 기준에 질문이 해당 */
export function escalator(question: string, ans: Answer, cards: Card[]): StepOut<Escalation> {
  if (ans.needsManager || ans.confidence === 'none') return { out: { escalate: true, why: 'no-evidence' }, summary: '점장에게 넘겼습니다 (근거 카드 없음)' };
  const hasEvidenceLine = ans.answer.split('\n').some((l) => /\[C\d{3,}\]/.test(l));
  if (!ans.cited.length || !hasEvidenceLine) return { out: { escalate: true, why: 'gate' }, summary: '점장에게 넘겼습니다 (검증을 통과한 근거 줄이 없음)' };
  const hit = cards.find((c) => ans.cited.includes(c.id) && c.escalateWhen && matchesCondition(c.escalateWhen, question));
  if (hit) return { out: { escalate: true, why: 'call', callCard: hit }, summary: `점장 호출 기준에 해당해 점장에게 넘겼습니다 ([${hit.id}] ${hit.escalateWhen})` };
  return { out: { escalate: false, why: 'none' }, summary: '위키 답으로 충분합니다' };
}
// 원본은 JSON 하나(var/store.json). 바뀔 때마다 사람이 읽는 마크다운 위키(data/wiki/)를 다시 컴파일한다.
import { copyFileSync, existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';
import type { Card, CardOrigin, CardStatus, EdgeType, LogEntry, Person, Question, Snapshot, Source } from '@shared/contracts';
import { DATA_DIR, STORE_DIR } from '../paths.js';

const STORE_FILE = join(STORE_DIR, 'store.json');
const SEED_FILE = join(DATA_DIR, 'seed.json');
const WIKI_DIR = join(DATA_DIR, 'wiki');

export interface Db extends Snapshot {
  links: { source: string; target: string; type: EdgeType }[]; // 점검관이 찾은 상충·중복
}

let db: Db | null = null;

export function load(): Db {
  if (!existsSync(STORE_FILE)) return resetFromSeed();
  db = JSON.parse(readFileSync(STORE_FILE, 'utf8')) as Db;
  db.links ??= [];
  return db;
}

export function resetFromSeed(): Db {
  mkdirSync(STORE_DIR, { recursive: true });
  copyFileSync(SEED_FILE, STORE_FILE);
  db = JSON.parse(readFileSync(STORE_FILE, 'utf8')) as Db;
  db.links = [];
  return db;
}

export function get(): Db {
  return db ?? load();
}

export function save(compile = process.env.STORE_DIR !== 'var/test') {
  writeFileSync(STORE_FILE, JSON.stringify(db, null, 1));
  if (compile) compileWiki();
}

export const today = () => get().store.today;
export const now = () => `${today()}T${new Date().toTimeString().slice(0, 8)}`;

export function addDays(date: string, days: number): string {
  const d = new Date(`${date}T00:00:00Z`);
  d.setUTCDate(d.getUTCDate() + days);
  return d.toISOString().slice(0, 10);
}

export function addLog(op: string, detail: string, runId?: string): LogEntry {
  const e = { time: now(), op, detail, runId };
  get().log.push(e);
  return e;
}

function nextId(prefix: string, list: { id: string }[]): string {
  const max = list.reduce((m, x) => Math.max(m, Number(x.id.slice(1)) || 0), 0);
  return prefix + String(max + 1).padStart(3, '0');
}

export interface CardFields {
  title: string; topic: string; situation: string; reason: string; actions: string[];
  avoid: string; escalateWhen: string; source: Source; tags: string[];
}

export function createCard(f: CardFields, authorId: string, status: CardStatus, origin: CardOrigin, fromQuestionId?: string): Card {
  const d = get();
  const card: Card = {
    id: nextId('C', d.cards),
    title: f.title,
    topic: d.topics.includes(f.topic) ? f.topic : '기타',
    situation: f.situation,
    reason: f.reason,
    actions: f.actions,
    avoid: f.avoid ?? '',
    escalateWhen: f.escalateWhen ?? '',
    source: f.source === '공식규정' ? '공식규정' : '현장노하우',
    authorId,
    status,
    origin,
    created: today(),
    updated: today(),
    expires: addDays(today(), f.source === '공식규정' ? 180 : 120),
    tags: f.tags ?? [],
    uses: 0,
    helpful: 0,
    notHelpful: 0,
    ...(fromQuestionId ? { fromQuestionId } : {}),
  };
  d.cards.push(card);
  return card;
}

export function createQuestion(f: Omit<Question, 'id' | 'time' | 'feedback'>): Question {
  const d = get();
  const q: Question = { id: nextId('Q', d.questions), time: now(), feedback: null, ...f };
  d.questions.push(q);
  return q;
}

export const card = (id: string) => get().cards.find((c) => c.id === id);
export const question = (id: string) => get().questions.find((q) => q.id === id);
export const person = (id: string) => get().people.find((p) => p.id === id);
export const approvedCards = () => get().cards.filter((c) => c.status === 'approved');
export const isExpired = (c: Card) => c.expires < today();

/** 신입 답의 근거로 쓸 수 있는 카드: 승인됐고, 만료 전이고, 공식규정과 상충한다고 표시된 현장노하우가 아닌 것 */
export function usableCards(): { usable: Card[]; excluded: { id: string; why: string }[] } {
  const d = get();
  const conflicted = new Set<string>();
  for (const l of d.links.filter((x) => x.type === 'conflicts')) {
    const [a, b] = [card(l.source), card(l.target)];
    if (a && b && a.source !== b.source) conflicted.add((a.source === '현장노하우' ? a : b).id);
  }
  const usable: Card[] = [];
  const excluded: { id: string; why: string }[] = [];
  for (const c of approvedCards()) {
    if (isExpired(c)) excluded.push({ id: c.id, why: `만료(${c.expires})` });
    else if (conflicted.has(c.id)) excluded.push({ id: c.id, why: '공식규정과 상충' });
    else usable.push(c);
  }
  return { usable, excluded };
}
export const personLabel = (id: string) => {
  const p = person(id);
  return p ? `${p.name}(${p.role} ${p.tenure})` : id;
};

export function findOrCreatePerson(name: string, role: Person['role'], tenure: string): Person {
  const d = get();
  const found = d.people.find((p) => p.name === name);
  if (found) return found;
  const p: Person = { id: nextId('P', d.people), name, role, tenure };
  d.people.push(p);
  return p;
}

// ---------- 마크다운 위키 (Karpathy LLM Wiki: index + log + 토픽 페이지 + 사람 페이지) ----------

const slug = (s: string) => s.replace(/[·\s/]/g, '-');

function cardMd(c: Card): string {
  return [
    `### [${c.id}] ${c.title}`,
    `- ${c.source} · 작성 ${personLabel(c.authorId)} · 갱신 ${c.updated} · 만료 ${c.expires} · 재사용 ${c.uses}회 (도움 ${c.helpful} / 안 됨 ${c.notHelpful})`,
    `- 상황: ${c.situation}`,
    `- 판단 이유: ${c.reason || '(비어 있음)'}`,
    `- 대응:`,
    ...c.actions.map((a, i) => `  ${i + 1}. ${a}`),
    c.avoid ? `- 하면 안 되는 것: ${c.avoid}` : '',
    c.escalateWhen ? `- 점장 호출 기준: ${c.escalateWhen}` : '',
    c.fromQuestionId ? `- 출처 질문: ${c.fromQuestionId} (점장 답변에서 생성)` : '',
    '',
  ].filter(Boolean).join('\n');
}

export function compileWiki() {
  const d = get();
  mkdirSync(join(WIKI_DIR, 'topics'), { recursive: true });
  const approved = approvedCards();
  const index = [
    `# ${d.store.name} 매장 위키`,
    '',
    `갱신 ${now()} · 승인 사례 ${approved.length} · 승인 대기 ${d.cards.filter((c) => c.status === 'pending').length} · 질문 ${d.questions.length}`,
    '',
    '| 토픽 | 사례 | 핵심 원칙 첫 줄 |',
    '|---|---|---|',
  ];
  for (const topic of d.topics) {
    const cards = approved.filter((c) => c.topic === topic);
    const summary = d.topicSummaries[topic] ?? '';
    index.push(`| [${topic}](topics/${slug(topic)}.md) | ${cards.length} | ${summary.split('\n')[0]?.replace(/^[-\s]+/, '').slice(0, 60) || '-'} |`);
    writeFileSync(
      join(WIKI_DIR, 'topics', `${slug(topic)}.md`),
      [`# ${topic}`, '', '## 핵심 판단 원칙 (종합 편집자)', '', summary || '_아직 종합되지 않음_', '', '## 사례 카드', '', ...cards.map(cardMd)].join('\n'),
    );
  }
  index.push('', '## 사람', '', '[기여자 목록](people.md)');
  writeFileSync(join(WIKI_DIR, 'index.md'), index.join('\n') + '\n');
  const people = d.people.map((p) => {
    const mine = approved.filter((c) => c.authorId === p.id);
    const asked = d.questions.filter((q) => q.askerId === p.id).length;
    return `- ${p.name} (${p.role} ${p.tenure}) · 남긴 사례 ${mine.length}${mine.length ? ` (${mine.map((c) => c.id).join(', ')})` : ''} · 질문 ${asked}`;
  });
  writeFileSync(join(WIKI_DIR, 'people.md'), ['# 사람', '', ...people].join('\n') + '\n');
  writeFileSync(join(WIKI_DIR, 'log.md'), ['# 변경 기록', '', ...d.log.map((l) => `- ${l.time} · ${l.op} · ${l.detail}`)].join('\n') + '\n');
}

