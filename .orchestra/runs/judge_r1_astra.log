// 원본은 JSON 하나(var/store.json). 바뀔 때마다 사람이 읽는 마크다운 위키(data/wiki/)를 다시 컴파일한다.
import { copyFileSync, existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';
import type { Card, CardOrigin, CardStatus, EdgeType, LogEntry, Person, Question, Snapshot, Source } from '@shared/contracts';
import { DATA_DIR, STORE_DIR } from '../paths.js';

const STORE_FILE = join(STORE_DIR, 'store.json');
const SEED_FILE = join(DATA_DIR, 'seed.json');
const WIKI_DIR = join(DATA_DIR, 'wiki');

export interface Db extends Snapshot {
  links: { source: string; target: string; type: EdgeType }[]; // 점검관이 찾은 상충·중복
}

let db: Db | null = null;

export function load(): Db {
  if (!existsSync(STORE_FILE)) return resetFromSeed();
  db = JSON.parse(readFileSync(STORE_FILE, 'utf8')) as Db;
  db.links ??= [];
  return db;
}

export function resetFromSeed(): Db {
  mkdirSync(STORE_DIR, { recursive: true });
  copyFileSync(SEED_FILE, STORE_FILE);
  db = JSON.parse(readFileSync(STORE_FILE, 'utf8')) as Db;
  db.links = [];
  return db;
}

export function get(): Db {
  return db ?? load();
}

export function save(compile = process.env.STORE_DIR !== 'var/test') {
  writeFileSync(STORE_FILE, JSON.stringify(db, null, 1));
  if (compile) compileWiki();
}

export const today = () => get().store.today;
export const now = () => `${today()}T${new Date().toTimeString().slice(0, 8)}`;

export function addDays(date: string, days: number): string {
  const d = new Date(`${date}T00:00:00Z`);
  d.setUTCDate(d.getUTCDate() + days);
  return d.toISOString().slice(0, 10);
}

export function addLog(op: string, detail: string, runId?: string): LogEntry {
  const e = { time: now(), op, detail, runId };
  get().log.push(e);
  return e;
}

function nextId(prefix: string, list: { id: string }[]): string {
  const max = list.reduce((m, x) => Math.max(m, Number(x.id.slice(1)) || 0), 0);
  return prefix + String(max + 1).padStart(3, '0');
}

export interface CardFields {
  title: string; topic: string; situation: string; reason: string; actions: string[];
  avoid: string; escalateWhen: string; source: Source; tags: string[];
}

export function createCard(f: CardFields, authorId: string, status: CardStatus, origin: CardOrigin, fromQuestionId?: string): Card {
  const d = get();
  const card: Card = {
    id: nextId('C', d.cards),
    title: f.title,
    topic: d.topics.includes(f.topic) ? f.topic : '기타',
    situation: f.situation,
    reason: f.reason,
    actions: f.actions,
    avoid: f.avoid ?? '',
    escalateWhen: f.escalateWhen ?? '',
    source: f.source === '공식규정' ? '공식규정' : '현장노하우',
    authorId,
    status,
    origin,
    created: today(),
    updated: today(),
    expires: addDays(today(), f.source === '공식규정' ? 180 : 120),
    tags: f.tags ?? [],
    uses: 0,
    helpful: 0,
    notHelpful: 0,
    ...(fromQuestionId ? { fromQuestionId } : {}),
  };
  d.cards.push(card);
  return card;
}

export function createQuestion(f: Omit<Question, 'id' | 'time' | 'feedback'>): Question {
  const d = get();
  const q: Question = { id: nextId('Q', d.questions), time: now(), feedback: null, ...f };
  d.questions.push(q);
  return q;
}

export const card = (id: string) => get().cards.find((c) => c.id === id);
export const question = (id: string) => get().questions.find((q) => q.id === id);
export const person = (id: string) => get().people.find((p) => p.id === id);
export const approvedCards = () => get().cards.filter((c) => c.status === 'approved');
export const personLabel = (id: string) => {
  const p = person(id);
  return p ? `${p.name}(${p.role} ${p.tenure})` : id;
};

export function findOrCreatePerson(name: string, role: Person['role'], tenure: string): Person {
  const d = get();
  const found = d.people.find((p) => p.name === name);
  if (found) return found;
  const p: Person = { id: nextId('P', d.people), name, role, tenure };
  d.people.push(p);
  return p;
}

// ---------- 마크다운 위키 (Karpathy LLM Wiki: index + log + 토픽 페이지 + 사람 페이지) ----------

const slug = (s: string) => s.replace(/[·\s/]/g, '-');

function cardMd(c: Card): string {
  return [
    `### [${c.id}] ${c.title}`,
    `- ${c.source} · 작성 ${personLabel(c.authorId)} · 갱신 ${c.updated} · 만료 ${c.expires} · 재사용 ${c.uses}회 (도움 ${c.helpful} / 안 됨 ${c.notHelpful})`,
    `- 상황: ${c.situation}`,
    `- 판단 이유: ${c.reason || '(비어 있음)'}`,
    `- 대응:`,
    ...c.actions.map((a, i) => `  ${i + 1}. ${a}`),
    c.avoid ? `- 하면 안 되는 것: ${c.avoid}` : '',
    c.escalateWhen ? `- 점장 호출 기준: ${c.escalateWhen}` : '',
    c.fromQuestionId ? `- 출처 질문: ${c.fromQuestionId} (점장 답변에서 생성)` : '',
    '',
  ].filter(Boolean).join('\n');
}

export function compileWiki() {
  const d = get();
  mkdirSync(join(WIKI_DIR, 'topics'), { recursive: true });
  const approved = approvedCards();
  const index = [
    `# ${d.store.name} 매장 위키`,
    '',
    `갱신 ${now()} · 승인 사례 ${approved.length} · 승인 대기 ${d.cards.filter((c) => c.status === 'pending').length} · 질문 ${d.questions.length}`,
    '',
    '| 토픽 | 사례 | 핵심 원칙 첫 줄 |',
    '|---|---|---|',
  ];
  for (const topic of d.topics) {
    const cards = approved.filter((c) => c.topic === topic);
    const summary = d.topicSummaries[topic] ?? '';
    index.push(`| [${topic}](topics/${slug(topic)}.md) | ${cards.length} | ${summary.split('\n')[0]?.replace(/^[-\s]+/, '').slice(0, 60) || '-'} |`);
    writeFileSync(
      join(WIKI_DIR, 'topics', `${slug(topic)}.md`),
      [`# ${topic}`, '', '## 핵심 판단 원칙 (종합 편집자)', '', summary || '_아직 종합되지 않음_', '', '## 사례 카드', '', ...cards.map(cardMd)].join('\n'),
    );
  }
  index.push('', '## 사람', '', '[기여자 목록](people.md)');
  writeFileSync(join(WIKI_DIR, 'index.md'), index.join('\n') + '\n');
  const people = d.people.map((p) => {
    const mine = approved.filter((c) => c.authorId === p.id);
    const asked = d.questions.filter((q) => q.askerId === p.id).length;
    return `- ${p.name} (${p.role} ${p.tenure}) · 남긴 사례 ${mine.length}${mine.length ? ` (${mine.map((c) => c.id).join(', ')})` : ''} · 질문 ${asked}`;
  });
  writeFileSync(join(WIKI_DIR, 'people.md'), ['# 사람', '', ...people].join('\n') + '\n');
  writeFileSync(join(WIKI_DIR, 'log.md'), ['# 변경 기록', '', ...d.log.map((l) => `- ${l.time} · ${l.op} · ${l.detail}`)].join('\n') + '\n');
}
import { useEffect, useMemo, useRef, useState } from 'react';
import { Check, Loader2, Minus, X } from 'lucide-react';
import type { AskResult, HarnessConfig, Question } from '@shared/contracts';
import { api } from '@/shared/api/client';
import { useLive, type RunView } from '@/shared/api/live';
import { Badge, Button, CardDetail, CiteText, Empty, Panel, Sheet, cx, inputCls, useToast, fmtTime } from '@/shared/ui';

const EXAMPLES = ['오트 우유가 품절이에요', '기프티콘이 사용완료로 떠요', '결제됐는데 주문이 없어요', '영수증 없이 환불해 달라고 해요', '알리페이로 결제하고 싶대요'];

const confTone = { high: 'success', low: 'warning', none: 'danger' } as const;
const confText = { high: '확실해요', low: '조금 불확실해요', none: '근거가 없어요' } as const;

function statusBadge(q: Question) {
  if (q.status === 'answered') return <Badge tone="brand">위키가 답함</Badge>;
  if (q.status === 'escalated') return <Badge tone="warning">점장 대기</Badge>;
  return <Badge tone="success">점장이 답함</Badge>;
}

function Progress({ run, names }: { run: RunView | undefined; names: Record<string, string> }) {
  return (
    <Panel title="에이전트 팀이 확인하고 있어요">
      {!run || (run.steps.length === 0 && !run.running) ? (
        <p className="text-[14px] text-ink-weak">팀을 모으는 중이에요</p>
      ) : (
        <ul className="space-y-2">
          {run.steps.map((s, i) => (
            <li key={i} className="flex items-start gap-2.5">
              <span className={cx('mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full', s.status === 'ok' ? 'bg-success-weak text-success' : s.status === 'skipped' ? 'bg-surface-subtle text-ink-weak' : 'bg-danger-weak text-danger')}>
                {s.status === 'ok' ? <Check size={12} /> : s.status === 'skipped' ? <Minus size={12} /> : <X size={12} />}
              </span>
              <div className="min-w-0">
                <p className="text-[14px] font-semibold text-ink-strong">{names[s.agentId] ?? s.agentId}</p>
                <p className="text-[13px] text-ink-body">{s.summary}</p>
              </div>
            </li>
          ))}
          {run.running && (
            <li className="flex items-center gap-2.5">
              <span className="flex h-5 w-5 items-center justify-center text-brand">
                <Loader2 size={16} className="animate-spin" />
              </span>
              <p className="text-[14px] font-semibold text-ink-strong">{names[run.running] ?? run.running}</p>
            </li>
          )}
        </ul>
      )}
    </Panel>
  );
}

export default function Page() {
  const { state, runs, me, refresh } = useLive();
  const toast = useToast();
  const [text, setText] = useState('');
  const [busy, setBusy] = useState(false);
  const [result, setResult] = useState<AskResult | null>(null);
  const [names, setNames] = useState<Record<string, string>>({});
  const [citeId, setCiteId] = useState<string | null>(null);
  const [openCard, setOpenCard] = useState<string | null>(null);
  const baseline = useRef<Set<string>>(new Set());

  useEffect(() => {
    api.harness().then((h: HarnessConfig) => setNames(Object.fromEntries(h.agents.map((a) => [a.id, a.name])))).catch(() => {});
  }, []);

  const run = useMemo(() => (busy ? runs.find((r) => r.flowName === '신입 질문' && !baseline.current.has(r.runId)) : undefined), [busy, runs]);

  const personName = (id: string) => state?.people.find((p) => p.id === id)?.name ?? id;
  const cardOf = (id: string | null) => state?.cards.find((c) => c.id === id);
  // 서버 최신 값을 우선하고, 아직 없으면 방금 받은 응답을 쓴다.
  const q = result ? state?.questions.find((x) => x.id === result.question.id) ?? result.question : null;
  const mine = (state?.questions ?? []).filter((x) => x.askerId === me).slice().reverse();

  async function submit(t = text) {
    const v = t.trim();
    if (!v || busy) return;
    baseline.current = new Set(runs.map((r) => r.runId));
    setResult(null);
    setBusy(true);
    try {
      setResult(await api.ask(v, me));
      setText('');
      void refresh();
    } catch (e) {
      toast(e instanceof Error ? e.message : '물어보지 못했어요. 다시 해 주세요');
    } finally {
      setBusy(false);
    }
  }

  async function feedback(solved: boolean) {
    if (!q) return;
    try {
      await api.feedback(q.id, solved);
      toast(solved ? '알려줘서 고마워요' : '의견을 남겼어요. 점장님이 같이 볼게요');
      void refresh();
    } catch (e) {
      toast(e instanceof Error ? e.message : '남기지 못했어요');
    }
  }

  const citeCard = cardOf(citeId) ?? cardOf(openCard);

  return (
    <div className="mx-auto w-full max-w-2xl pb-16">
      <h1 className="mb-1 text-title text-ink-strong">지금 어떤 상황이에요?</h1>
      <p className="mb-5 text-body text-ink-body">매장 위키에서 찾아서 이유와 함께 알려드려요.</p>

      <div className="space-y-3">
        <textarea
          className={cx(inputCls, 'min-h-[88px] resize-none text-[16px]')}
          placeholder="예: 오트 우유가 다 떨어졌는데 손님이 찾아요"
          value={text}
          disabled={busy}
          onChange={(e) => setText(e.target.value)}
          onKeyDown={(e) => {
            if (e.key === 'Enter' && !e.shiftKey && !e.nativeEvent.isComposing) {
              e.preventDefault();
              void submit();
            }
          }}
        />
        <div className="flex flex-wrap gap-2">
          {EXAMPLES.map((ex) => (
            <button key={ex} disabled={busy} onClick={() => void submit(ex)} className="rounded-full bg-surface-subtle px-3 py-1.5 text-[13px] font-medium text-ink-body hover:bg-line disabled:opacity-40">
              {ex}
            </button>
          ))}
        </div>
        <Button size="lg" loading={busy} disabled={!text.trim()} onClick={() => void submit()}>
          물어보기
        </Button>
      </div>

      <div className="mt-6 space-y-4">
        {busy && <Progress run={run} names={names} />}

        {q && !busy && (
          <Panel>
            <div className="mb-3 flex flex-wrap items-center gap-1.5">
              {statusBadge(q)}
              <Badge tone={confTone[q.confidence]}>{confText[q.confidence]}</Badge>
            </div>
            <p className="mb-2 text-[13px] text-ink-weak">{q.text}</p>
            {q.status === 'escalated' ? (
              <div className="rounded-xl bg-warning-weak p-4 text-[14px] text-ink-strong">
                <p className="font-semibold">이건 점장님이 직접 봐 주셔야 해요.</p>
                <p className="mt-1 text-ink-body">점장님께 전달했어요. 답이 오면 이 화면에 보이고, 다음 사람을 위한 위키 카드로도 남아요.</p>
                {q.answer && <div className="mt-3 text-ink-body"><CiteText text={q.answer} onCite={setCiteId} /></div>}
              </div>
            ) : (
              <div className="text-[15px] leading-6 text-ink-strong">
                <CiteText text={q.answer} onCite={setCiteId} />
              </div>
            )}
            {q.status === 'resolved' && q.managerAnswer && (
              <div className="mt-3 rounded-xl bg-success-weak p-4 text-[14px]">
                <p className="mb-1 font-semibold text-success">점장님이 답했어요</p>
                <p className="text-ink-strong">{q.managerAnswer}</p>
                {q.cardId && <button onClick={() => setCiteId(q.cardId!)} className="mt-2 text-[13px] font-semibold text-brand-strong">위키 카드 {q.cardId} 보기</button>}
              </div>
            )}
            {q.why && (
              <div className="mt-4 rounded-xl bg-surface-subtle p-4">
                <p className="mb-1 text-[13px] font-semibold text-ink-body">왜 이렇게 하나요</p>
                <p className="text-[14px] text-ink-strong">{q.why}</p>
              </div>
            )}
            {q.status === 'answered' &&
              (q.feedback ? (
                <p className="mt-4 text-[13px] text-ink-weak">{q.feedback === 'solved' ? '해결됐다고 남겼어요' : '해결이 안 됐다고 남겼어요'}</p>
              ) : (
                <div className="mt-4 grid grid-cols-2 gap-2">
                  <Button onClick={() => void feedback(true)}>해결됐어요</Button>
                  <Button variant="ghost" onClick={() => void feedback(false)}>해결이 안 됐어요</Button>
                </div>
              ))}
          </Panel>
        )}

        <Panel title="내가 물은 질문">
          {mine.length === 0 ? (
            <Empty>아직 물어본 게 없어요</Empty>
          ) : (
            <ul className="divide-y divide-line">
              {mine.map((m) => (
                <li key={m.id} className="py-3">
                  <div className="flex items-start justify-between gap-2">
                    <p className="text-[14px] font-medium text-ink-strong">{m.text}</p>
                    {statusBadge(m)}
                  </div>
                  <p className="mt-0.5 text-[12px] text-ink-weak">{fmtTime(m.time)}</p>
                  {m.status === 'resolved' && (
                    <div className="mt-2 text-[13px] text-ink-body">
                      {m.managerAnswer}
                      {m.cardId && <button onClick={() => setOpenCard(m.cardId!)} className="ml-2 font-semibold text-brand-strong">카드 {m.cardId}</button>}
                    </div>
                  )}
                  {m.status === 'answered' && m.cited.length > 0 && (
                    <div className="mt-1.5 flex flex-wrap gap-1">
                      {m.cited.map((c) => (
                        <button key={c} onClick={() => setOpenCard(c)} className="rounded bg-brand-weak px-1.5 py-px text-[12px] font-semibold text-brand-strong">{c}</button>
                      ))}
                    </div>
                  )}
                </li>
              ))}
            </ul>
          )}
        </Panel>
      </div>

      <Sheet open={!!(citeId || openCard)} onClose={() => { setCiteId(null); setOpenCard(null); }}>
        {citeCard ? <CardDetail card={citeCard} authorName={personName(citeCard.authorId)} /> : <Empty>카드를 찾지 못했어요</Empty>}
      </Sheet>
    </div>
  );
}
import { useEffect, useMemo, useRef, useState } from 'react';
import { Check, Mic, Square } from 'lucide-react';
import type { InterviewDraft, Source } from '@shared/contracts';
import { api, type FollowupAnswer } from '@/shared/api/client';
import { useLive } from '@/shared/api/live';
import { Badge, Button, Empty, Field, PageHeader, Panel, cx, inputCls, useToast } from '@/shared/ui';

type Step = 1 | 2 | 3 | 4;
const STEPS = ['있었던 일', 'AI가 되묻기', '카드 확인'];
const AGENT_NAMES: Record<string, string> = {
  'privacy-guard': '개인정보 가드',
  interviewer: '인터뷰어',
  'card-writer': '카드 작성',
  'wording-guard': '표현 검증',
};

interface RecognitionLike {
  lang: string;
  continuous: boolean;
  interimResults: boolean;
  onresult: ((e: { resultIndex: number; results: ArrayLike<{ isFinal: boolean; 0: { transcript: string } }> }) => void) | null;
  onend: (() => void) | null;
  onerror: (() => void) | null;
  start: () => void;
  stop: () => void;
}
type RecognitionCtor = new () => RecognitionLike;
const getRecognition = (): RecognitionCtor | undefined => {
  const w = window as unknown as { SpeechRecognition?: RecognitionCtor; webkitSpeechRecognition?: RecognitionCtor };
  return w.SpeechRecognition ?? w.webkitSpeechRecognition;
};

function exampleChips(q: string): string[] {
  if (/이유|왜/.test(q)) return ['손님이 안전하지 않을 수 있어서요', '나중에 더 큰 비용이 들어서요'];
  if (/금지|하면 안|절대/.test(q)) return ['절대 그냥 두면 안 돼요', '혼자 판단해서 처리하지 마세요'];
  if (/점장|호출|부르/.test(q)) return ['두 번 해도 안 되면 점장님께 알려요', '손님이 화를 내면 바로 불러요'];
  return [];
}

function Stepper({ step }: { step: Step }) {
  return (
    <ol className="mb-6 flex items-center gap-2">
      {STEPS.map((label, i) => {
        const n = i + 1;
        const done = step > n;
        const cur = step === n;
        return (
          <li key={label} className="flex flex-1 items-center gap-2">
            <span className={cx('flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-[13px] font-bold', done || cur ? 'bg-brand text-white' : 'bg-surface-subtle text-ink-weak')}>
              {done ? <Check size={14} /> : n}
            </span>
            <span className={cx('truncate text-[13px] font-semibold', cur ? 'text-ink-strong' : 'text-ink-weak')}>{label}</span>
            {n < 3 && <span className={cx('h-px flex-1', done ? 'bg-brand' : 'bg-line')} />}
          </li>
        );
      })}
    </ol>
  );
}

export default function Page() {
  const { state, runs, me, refresh } = useLive();
  const toast = useToast();
  const [step, setStep] = useState<Step>(1);
  const [raw, setRaw] = useState('');
  const [draft, setDraft] = useState<InterviewDraft | null>(null);
  const [answers, setAnswers] = useState<string[]>([]);
  const [busy, setBusy] = useState(false);
  const [startedAt, setStartedAt] = useState<string>('');
  const [actionsText, setActionsText] = useState('');
  const [result, setResult] = useState<'approved' | 'pending' | null>(null);
  const [listening, setListening] = useState(false);
  const recRef = useRef<RecognitionLike | null>(null);
  const Rec = useMemo(() => getRecognition(), []);

  const person = state?.people.find((p) => p.id === me);
  const run = useMemo(() => (startedAt ? runs.find((r) => r.flowName === '노하우 기록' && r.at >= startedAt) : undefined), [runs, startedAt]);

  useEffect(() => () => recRef.current?.stop(), []);

  const toggleVoice = () => {
    if (!Rec) return;
    if (listening) {
      recRef.current?.stop();
      return;
    }
    const r = new Rec();
    r.lang = 'ko-KR';
    r.continuous = true;
    r.interimResults = false;
    r.onresult = (e) => {
      let text = '';
      for (let i = e.resultIndex; i < e.results.length; i++) if (e.results[i].isFinal) text += e.results[i][0].transcript;
      if (text) setRaw((v) => (v ? v + ' ' : '') + text.trim());
    };
    r.onend = () => setListening(false);
    r.onerror = () => setListening(false);
    recRef.current = r;
    r.start();
    setListening(true);
  };

  const applyDraft = (d: InterviewDraft) => {
    setDraft(d);
    setActionsText(d.actions.join('\n'));
  };

  const start = async () => {
    recRef.current?.stop();
    setBusy(true);
    setStartedAt(new Date().toISOString());
    try {
      const d = await api.interview(raw.trim(), me);
      applyDraft(d);
      if (d.followups.length > 0) {
        setAnswers(d.followups.map(() => ''));
        setStep(2);
      } else setStep(3);
    } catch (e) {
      toast(e instanceof Error ? e.message : '정리하지 못했어요');
    } finally {
      setBusy(false);
    }
  };

  const answer = async () => {
    if (!draft) return;
    setBusy(true);
    setStartedAt(new Date().toISOString());
    const list: FollowupAnswer[] = draft.followups.map((q, i) => ({ question: q, answer: answers[i] ?? '' })).filter((a) => a.answer.trim());
    try {
      applyDraft(await api.interview(raw.trim(), me, list));
      setStep(3);
    } catch (e) {
      toast(e instanceof Error ? e.message : '카드를 만들지 못했어요');
    } finally {
      setBusy(false);
    }
  };

  const submit = async () => {
    if (!draft) return;
    setBusy(true);
    try {
      const { followups: _f, masked: _m, problems: _p, ...fields } = draft;
      const actions = actionsText.split('\n').map((s) => s.trim()).filter(Boolean);
      const card = await api.submitCard({ ...fields, actions }, me);
      setResult(card.status === 'approved' ? 'approved' : 'pending');
      setStep(4);
      void refresh();
    } catch (e) {
      toast(e instanceof Error ? e.message : '올리지 못했어요');
    } finally {
      setBusy(false);
    }
  };

  const reset = () => {
    setStep(1);
    setRaw('');
    setDraft(null);
    setAnswers([]);
    setActionsText('');
    setResult(null);
    setStartedAt('');
  };

  const set = <K extends keyof InterviewDraft>(k: K, v: InterviewDraft[K]) => setDraft((d) => (d ? { ...d, [k]: v } : d));

  const progress = (busy || run) && step <= 3 && (
    <Panel title="AI가 일하는 중이에요" className="mt-4 bg-surface-subtle">
      {run ? (
        <ul className="space-y-2">
          {run.steps.map((s, i) => (
            <li key={i} className="flex items-start gap-2 text-[14px]">
              <Check size={16} className="mt-0.5 shrink-0 text-success" />
              <span>
                <b className="text-ink-strong">{AGENT_NAMES[s.agentId] ?? s.agentId}</b> <span className="text-ink-body">{s.summary}</span>
              </span>
            </li>
          ))}
          {run.running && (
            <li className="flex items-center gap-2 text-[14px] text-ink-weak">
              <span className="h-4 w-4 animate-spin rounded-full border-2 border-brand border-t-transparent" />
              {AGENT_NAMES[run.running] ?? run.running}
            </li>
          )}
        </ul>
      ) : (
        <p className="text-[14px] text-ink-weak">곧 시작해요</p>
      )}
      {draft && draft.masked > 0 && <p className="mt-3 text-[13px] font-semibold text-brand-strong">개인정보 {draft.masked}곳을 가렸어요</p>}
    </Panel>
  );

  return (
    <div className="mx-auto max-w-2xl">
      <PageHeader eyebrow="노하우 남기기" title={step === 4 ? '남겨 주셔서 고마워요' : '노하우 남기기'} />
      {step < 4 && <Stepper step={step} />}

      {step === 1 && (
        <>
          <h2 className="mb-3 text-sub text-ink-strong">방금 있었던 일을 30초만 남겨 주세요</h2>
          <textarea
            className={cx(inputCls, 'min-h-40')}
            value={raw}
            onChange={(e) => setRaw(e.target.value)}
            placeholder="예: 오늘 아침에 냉장고 온도가 9도까지 올라가 있었어요. 우유랑 생크림을 확인하고 문 앞쪽 것만 버렸어요. 점장님께 바로 알렸고요."
          />
          <div className="mt-3 flex gap-2">
            {Rec && (
              <Button variant="ghost" onClick={toggleVoice} type="button">
                {listening ? <Square size={16} /> : <Mic size={16} />}
                {listening ? '그만 말하기' : '말로 남기기'}
              </Button>
            )}
            <Button className="flex-1" disabled={raw.trim().length < 5} loading={busy} onClick={() => void start()}>
              AI에게 정리 맡기기
            </Button>
          </div>
          {progress}
        </>
      )}

      {step === 2 && draft && (
        <>
          <h2 className="mb-3 text-sub text-ink-strong">조금만 더 알려 주세요</h2>
          {draft.masked > 0 && <p className="mb-3 text-[13px] font-semibold text-brand-strong">개인정보 {draft.masked}곳을 가렸어요</p>}
          <div className="space-y-3">
            {draft.followups.map((q, i) => (
              <Panel key={i} title={<span className="text-[13px] text-brand-strong">AI가 궁금한 점</span>}>
                <p className="mb-3 text-[16px] font-semibold text-ink-strong">{q}</p>
                <textarea className={cx(inputCls, 'min-h-20')} value={answers[i] ?? ''} placeholder="짧게 한두 문장이면 돼요" onChange={(e) => setAnswers((a) => a.map((x, j) => (j === i ? e.target.value : x)))} />
                <div className="mt-2 flex flex-wrap gap-1.5">
                  {exampleChips(q).map((c) => (
                    <button key={c} type="button" className="rounded-full bg-brand-weak px-3 py-1.5 text-[13px] font-medium text-brand-strong hover:bg-[#D6E8FF]" onClick={() => setAnswers((a) => a.map((x, j) => (j === i ? c : x)))}>
                      {c}
                    </button>
                  ))}
                </div>
              </Panel>
            ))}
          </div>
          <div className="mt-4 flex gap-2">
            <Button variant="ghost" onClick={() => setStep(1)}>
              이전
            </Button>
            <Button className="flex-1" loading={busy} onClick={() => void answer()}>
              답하고 카드 만들기
            </Button>
          </div>
          {progress}
        </>
      )}

      {step === 3 && draft && (
        <>
          <h2 className="mb-1 text-sub text-ink-strong">카드를 확인해 주세요</h2>
          <p className="mb-4 text-[14px] text-ink-body">틀린 곳은 바로 고칠 수 있어요.</p>
          {draft.masked > 0 && <p className="mb-3 text-[13px] font-semibold text-brand-strong">개인정보 {draft.masked}곳을 가렸어요</p>}
          {draft.problems.length > 0 && (
            <div className="mb-4 space-y-2">
              {draft.problems.map((p, i) => (
                <div key={i} className="rounded-xl bg-warning-weak px-4 py-3 text-[14px] text-warning">
                  {p}
                </div>
              ))}
            </div>
          )}
          <div className="space-y-4 rounded-card bg-surface p-5">
            <Field label="제목">
              <input className={inputCls} value={draft.title} onChange={(e) => set('title', e.target.value)} />
            </Field>
            <Field label="주제">
              <select className={inputCls} value={draft.topic} onChange={(e) => set('topic', e.target.value)}>
                {[...new Set([...(state?.topics ?? []), draft.topic])].map((t) => (
                  <option key={t}>{t}</option>
                ))}
              </select>
            </Field>
            <div>
              <span className="mb-1.5 block text-[13px] font-semibold text-ink-body">출처</span>
              <div className="grid grid-cols-2 gap-1 rounded-xl bg-surface-subtle p-1">
                {(['공식규정', '현장노하우'] as Source[]).map((s) => (
                  <button key={s} type="button" onClick={() => set('source', s)} className={cx('h-10 rounded-lg text-[14px] font-semibold', draft.source === s ? 'bg-surface text-ink-strong' : 'text-ink-weak')}>
                    {s}
                  </button>
                ))}
              </div>
            </div>
            <Field label="상황">
              <textarea className={cx(inputCls, 'min-h-20')} value={draft.situation} onChange={(e) => set('situation', e.target.value)} />
            </Field>
            <div className="rounded-xl border-2 border-brand bg-brand-weak/50 p-3">
              <Field label="판단 이유" hint="판단 이유가 신입에게 가장 도움이 돼요">
                <textarea className={cx(inputCls, 'min-h-24')} value={draft.reason} placeholder="왜 그렇게 하는지 적어 주세요" onChange={(e) => set('reason', e.target.value)} />
              </Field>
            </div>
            <Field label="대응 방법" hint="한 줄에 하나씩 적어요">
              <textarea className={cx(inputCls, 'min-h-24')} value={actionsText} onChange={(e) => setActionsText(e.target.value)} />
            </Field>
            <Field label="하면 안 되는 것">
              <textarea className={cx(inputCls, 'min-h-16')} value={draft.avoid} onChange={(e) => set('avoid', e.target.value)} />
            </Field>
            <Field label="점장을 불러야 할 때">
              <textarea className={cx(inputCls, 'min-h-16')} value={draft.escalateWhen} onChange={(e) => set('escalateWhen', e.target.value)} />
            </Field>
          </div>
          <div className="mt-4 flex gap-2">
            <Button variant="ghost" onClick={() => setStep(draft.followups.length ? 2 : 1)}>
              이전
            </Button>
            <Button className="flex-1" loading={busy} disabled={!draft.title.trim()} onClick={() => void submit()}>
              위키에 올리기
            </Button>
          </div>
        </>
      )}

      {step === 4 && (
        <Panel className="text-center">
          <div className="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-success-weak text-success">
            <Check size={28} />
          </div>
          <h2 className="text-sub text-ink-strong">{result === 'approved' || person?.role === '점장' ? '바로 위키에 반영됐어요' : '점장 승인 후 위키에 반영돼요'}</h2>
          <p className="mt-2 text-[14px] text-ink-body">남긴 노하우는 이름과 함께 기여 크레딧으로 쌓여요</p>
          <div className="mt-3">{person && <Badge tone="brand">{person.name}</Badge>}</div>
          <Button size="lg" className="mt-6" onClick={reset}>
            하나 더 남기기
          </Button>
        </Panel>
      )}
      {step === 1 && !state && <Empty>불러오는 중이에요</Empty>}
    </div>
  );
}
// 지표: 지식이 쌓이는 양보다 '다시 쓰이는가'를 본다(KCS: 문서 수가 아니라 재사용 후 해결률).
import { useEffect, useState } from 'react';
import { Bar, BarChart, CartesianGrid, Legend, Line, LineChart, ResponsiveContainer, Tooltip, XAxis, YAxis } from 'recharts';
import type { Metrics } from '@shared/contracts';
import { api } from '@/shared/api/client';
import { useLive } from '@/shared/api/live';
import { Empty, PageHeader, Panel } from '@/shared/ui';
import { CHART } from '@/shared/theme/tokens';

const axis = { stroke: CHART.axis, fontSize: 12, tickLine: false, axisLine: false } as const;
const tip = { contentStyle: { borderRadius: 12, border: '1px solid #E5E8EB', fontSize: 13 }, cursor: { fill: '#F2F4F6' } };

export default function MetricsPage() {
  const { state } = useLive();
  const [m, setM] = useState<Metrics | null>(null);
  useEffect(() => void api.metrics().then(setM), [state]);
  if (!m) return null;

  const outcome = [{ name: '질문', 위키가답함: m.answeredByWiki, 점장대기: m.escalated, 점장답카드: m.resolvedToCards }];

  return (
    <>
      <PageHeader eyebrow="시스템" title="지표" desc="문서 수보다 다시 쓰였는지를 봐요. 시연 데이터라 실제 매장 효과를 뜻하지 않아요. 현장 검증에서 같은 지표로 측정할 계획이에요." />
      <div className="mb-5 grid grid-cols-2 gap-3 md:grid-cols-4">
        <Tile label="재사용된 횟수(누적)" value={m.totalReuse} />
        <Tile label="해결됐다고 답한 비율" value={m.solvedRate === null ? '-' : `${m.solvedRate}%`} />
        <Tile label="판단 이유가 채워진 카드" value={`${m.reasonCoverage}%`} />
        <Tile label="공식규정 : 현장노하우" value={`${m.bySource['공식규정']} : ${m.bySource['현장노하우']}`} />
      </div>
      <div className="grid gap-5 lg:grid-cols-2">
        <Panel title="토픽별 승인 사례">
          <ResponsiveContainer width="100%" height={260}>
            <BarChart data={m.byTopic} margin={{ left: -20 }}>
              <CartesianGrid vertical={false} stroke={CHART.grid} />
              <XAxis dataKey="topic" {...axis} interval={0} tick={{ fontSize: 11 }} />
              <YAxis allowDecimals={false} {...axis} />
              <Tooltip {...tip} formatter={(v) => [`${v}개`, '사례']} />
              <Bar dataKey="n" fill={CHART.brand} radius={[4, 4, 0, 0]} maxBarSize={28} />
            </BarChart>
          </ResponsiveContainer>
        </Panel>
        <Panel title="질문은 어떻게 끝났나">
          <ResponsiveContainer width="100%" height={140}>
            <BarChart data={outcome} layout="vertical" margin={{ left: -20 }}>
              <XAxis type="number" allowDecimals={false} {...axis} />
              <YAxis type="category" dataKey="name" {...axis} />
              <Tooltip {...tip} />
              <Legend wrapperStyle={{ fontSize: 12 }} />
              <Bar dataKey="위키가답함" name="위키가 답함" stackId="a" fill={CHART.brand} stroke="#fff" strokeWidth={2} />
              <Bar dataKey="점장대기" name="점장 대기" stackId="a" fill={CHART.orange} stroke="#fff" strokeWidth={2} />
              <Bar dataKey="점장답카드" name="점장 답 → 카드" stackId="a" fill={CHART.teal} stroke="#fff" strokeWidth={2} radius={[0, 4, 4, 0]} />
            </BarChart>
          </ResponsiveContainer>
          <p className="mt-2 text-[13px] text-ink-body">
            점장 답이 카드가 되면 다음 같은 질문은 위키가 답해요. 이 비율이 오를수록 점장이 같은 설명을 덜 반복해요.
          </p>
        </Panel>
        <Panel title="날짜별 쌓인 카드와 질문">
          {m.timeline.length > 1 ? (
            <ResponsiveContainer width="100%" height={240}>
              <LineChart data={m.timeline} margin={{ left: -20 }}>
                <CartesianGrid vertical={false} stroke={CHART.grid} />
                <XAxis dataKey="day" {...axis} tickFormatter={(d: string) => d.slice(5)} />
                <YAxis allowDecimals={false} {...axis} />
                <Tooltip {...tip} cursor={{ stroke: CHART.axis }} />
                <Legend wrapperStyle={{ fontSize: 12 }} />
                <Line type="monotone" dataKey="cards" name="카드" stroke={CHART.teal} strokeWidth={2} dot={{ r: 4 }} />
                <Line type="monotone" dataKey="questions" name="질문" stroke={CHART.orange} strokeWidth={2} dot={{ r: 4 }} />
              </LineChart>
            </ResponsiveContainer>
          ) : (
            <Empty>하루치 데이터만 있어요.</Empty>
          )}
        </Panel>
        <Panel title="노하우 기여 크레딧">
          <table className="w-full text-[14px]">
            <thead>
              <tr className="text-left text-[12px] text-ink-weak">
                <th className="pb-2 font-medium">이름</th>
                <th className="pb-2 font-medium">남긴 사례</th>
                <th className="pb-2 font-medium">도운 횟수</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-line">
              {m.contributors.map((c) => (
                <tr key={c.personId}>
                  <td className="py-2 font-semibold">{c.name}</td>
                  <td className="py-2">{c.cards}</td>
                  <td className="py-2">{c.helped}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p className="mt-3 text-[12px] text-ink-weak">AI를 의식하면 암묵지 공유가 줄 수 있다는 연구(Zhang 외 2025, IJCHM)를 따라, 기여는 드러내고 질문자 개인 통계는 만들지 않아요.</p>
        </Panel>
      </div>
    </>
  );
}

function Tile({ label, value }: { label: string; value: number | string }) {
  return (
    <div className="rounded-card bg-surface p-4">
      <p className="text-[13px] text-ink-weak">{label}</p>
      <p className="mt-1 text-[26px] font-bold leading-9 text-ink-strong">{value}</p>
    </div>
  );
}

