 fail=['LLM 호출 실패 시 규칙 답변을 만들고 규칙 모드로 표시한다.', 'answer-gate 실패 시 근거 없는 문장을 빼고 다시 확인한다.', '남는 문장이 없으면 점장에게 넘긴다. 근거 없이 답을 늘리지 않는다.'],
 theory=['Aamodt & Plaza(1994)의 4R 중 Reuse에 해당한다.', '찾은 과거 사례를 지금 질문에 적용하는 역할이다.', '적용이 어려운 사례는 점장 수정과 재축적 단계로 이어진다.'],
 feel='지금 할 일과 그 이유를 같은 답에서 확인한다.'),
'escalator': dict(
 work=['근거 부족과 검증 결과를 보고 점장 연결 여부를 정한다.', '카드의 호출 기준에 해당할 수 있으면 그 기준을 알린다.'],
 inp=['"'`question`, `ans`: 질문과 검증된 답. 예: `ans.needsManager: true`.'"', '"'`gatePassed`, `cards`: 게이트 통과 여부와 카드. 예: `false`, `[{id: "C003", ...}]`.'"'],
 out=['"'`escalate`: 점장에게 넘길지 여부. 예: `true`.'"', '"'`note`: 연결 사유나 호출 안내. 예: `근거 카드 없음`.'"'],
 rules=['needsManager가 true이거나 confidence가 none이면 점장에게 넘긴다.', '게이트 실패 뒤 유효한 인용도 없으면 점장에게 넘긴다.', '호출 기준은 인용한 카드의 escalateWhen에서 읽는다.', '현재 규칙은 질문과 호출 기준의 containment가 0.35 이상이면 호출 가능성을 안내한다. 이 조건만으로 자동 연결하지는 않는다.', '노트의 큰 환불·안전·폭언 사례는 위험 예시다. 공통 금액 기준을 새로 정하지 않는다.'],
 no=['LLM을 호출하지 않는다. 연결 여부와 사유 표시는 규칙이 맡는다.', '점장 대신 보상을 승인하거나 아직 오지 않은 점장 답을 만들지 않는다.'],
 fail=['answer-gate의 onFail에 따라 근거 없는 문장을 빼고 다시 확인한다.', '남는 문장이 없으면 점장에게 넘긴다.', '점장 답변은 resolve 흐름에서 가림·카드 편집·표현 검증·종합을 거쳐 재축적한다.'],
 theory=['Aamodt & Plaza(1994)의 4R 중 Revise와 Retain으로 넘어가는 연결점이다.', '참고 노트 5절은 위험한 예외를 매니저에게 넘기고 결정을 다시 위키에 남기도록 제안한다.', '지금 답하지 못한 질문도 다음에 쓸 사례가 되도록 하는 설계다.'],
 feel='혼자 판단하기 어려운 질문을 점장에게 넘길 수 있다.'),
'citation-checker': dict(
 work=['답에 붙은 카드 번호가 실제 승인 카드인지 확인한다.', '검색한 카드인지도 확인하고 근거 표시가 빠진 부분을 찾는다.'],
 inp=['"'`ans`: 코치 답. 예: `answer: "바코드를 확인하세요 [C003]"`.'"', '"'`approvedIds`, `retrievedIds`: 승인·검색 카드 집합. 예: 각각 `{"C003"}`.'"'],
 out=['"'`answer`: 검사를 반영한 답. 예: `cited: ["C003"]`.'"', '"'`problems`: 근거 문제 목록. 예: `["검색되지 않은 카드 인용: C999"]`.'"'],
 rules=['[C003]처럼 C와 세 자리 이상 숫자로 된 카드 번호를 찾는다.', '본문과 cited의 카드 번호가 승인 집합에 없으면 문제로 기록한다.', '승인 카드라도 검색 집합에 없으면 문제로 기록한다.', '근거 표시가 없는 행동 문장은 answer-gate에서 제거 후 재확인할 대상이다.', '번호의 존재 검사는 문장의 의미가 카드와 같다는 보증이 아니다. 의미 검증을 마쳤다고 표시하지 않는다.'],
 no=['LLM을 호출하지 않는다. 카드 집합 대조와 표식 검사는 규칙이 맡는다.', '번호가 없는 문장에 비슷해 보이는 카드 번호를 임의로 붙이지 않는다.'],
 fail=['answer-gate 실패 시 근거 없는 문장을 빼고 다시 확인한다.', '남는 문장이 없으면 점장에게 넘긴다.', '없는 카드 번호를 새 카드 생성으로 맞추지 않는다.'],
 theory=['Aamodt & Plaza(1994)의 4R 중 Reuse를 과거 사례에 묶어 두는 검사다.', '새 답이 어느 사례를 재사용했는지 추적하려는 설계다.', '카드 번호 검사 방식 자체가 해당 논문에서 검증된 것은 아니다.'],
 feel='답에 붙은 카드 번호를 보고 실제 승인 사례를 찾아볼 수 있다.'),
'policy-checker': dict(
 work=['인용 카드에서 공식규정과 현장노하우가 함께 쓰였는지 본다.', '같은 토픽에서 두 출처가 섞이면 공식규정 우선 안내를 확인한다.'],
 inp=['"'`ans`: 인용 검사를 거친 답. 예: `cited: ["C006", "C007"]`.'"', '"'`cards`: 승인 카드 목록. 예: `source: "공식규정", topic: "교환·환불"`.'"'],
 out=['"'`answer`: 우선 안내를 반영한 답. 예: `공식규정을 따르세요. [C006]`.'"', '"'`problems`: 안내 누락 목록. 예: `["규정 우선 안내 누락"]`.'"'],
 rules=['검사는 ans.cited에 든 승인 카드를 대상으로 한다.', '같은 토픽에 서로 다른 source가 있으면 혼합 인용으로 본다.', '혼합 인용인데 답에 공식규정 안내가 없으면 누락으로 기록하고 안내를 덧붙인다.', '같은 토픽의 혼합 인용은 보수적인 확인 조건이다. 실제 모순을 뜻한다고 단정하지 않는다.', '공식규정 카드가 없으면 현장노하우를 공식규정으로 바꾸지 않는다.'],
 no=['LLM을 호출하지 않는다. 토픽·출처 비교와 안내 누락 검사는 규칙이 맡는다.', '법률 해석이나 본사 규정 개정을 하지 않는다.'],
 fail=['안내 누락도 answer-gate 문제로 남긴다. 안내 추가만으로 통과를 선언하지 않는다.', '게이트 실패 시 근거 없는 문장을 빼고 다시 확인한다.', '남는 문장이 없으면 점장에게 넘긴다.'],
 theory=['Aamodt & Plaza(1994)의 4R은 과거 사례의 재사용과 수정을 구분한다.', '다른 조건의 현장 관행을 그대로 적용하지 않도록 확인하는 설계에 이 구분을 쓴다.', '공식규정 우선순위는 이 서비스의 정책이다. 4R이 정한 규정 체계는 아니다.'],
 feel='선배의 관행과 공식규정이 함께 나와도 무엇을 따라야 할지 안다.'),
'wording-guard': dict(
 work=['답변과 사례 카드 문장을 금지 표현 정책과 대조한다.', '일치한 표현과 차단 이유를 작성자나 게이트에 돌려준다.'],
 inp=['"'`text`: 검사할 문장. 예: `확인한 뒤 점장에게 보고한다`.'"', '"'`rules`: 금지 표현 정책. 예: `blame-customer` 규칙.'"'],
 out=['"'`problems`: 일치 표현과 이유 목록. 예: `[]`.'"', '"'`status`: 검사 상태. 예: `ok`; 한 건 이상이면 `blocked`.'"'],
 rules=['금지 표현 일치가 0건이면 이 검사에서 통과한다.', '1건 이상이면 blocked로 표시하고 정책의 why를 함께 남긴다.', '고객 비난·보상 단정·임의 무료 약속을 정책 정규식으로 검사한다.', '예외를 지우는 단정·AI 확신 표현·점장 보고 금지도 같은 정책으로 검사한다.', '정규식에 걸리지 않았다는 사실을 내용 전체가 적절하다는 보증으로 쓰지 않는다.'],
 no=['LLM을 호출하지 않는다. 일치 탐지와 차단 사유는 정책 규칙이 맡는다.', '금지 표현을 몰래 순화해 원래 작성자가 동의한 문장으로 취급하지 않는다.'],
 fail=['ask의 answer-gate 실패 시 근거 없는 문장을 빼고 다시 확인한다.', '남는 문장이 없으면 점장에게 넘긴다. 표현 문제도 재확인 대상으로 남긴다.', 'record의 card-gate 실패 시 막힌 표현을 표시하고 작성자에게 돌려보낸다. 저장은 승인 대기로 둔다.'],
 theory=['참고 노트 5절은 위험한 예외를 점장에게 넘기는 설계를 제안한다.', '표현 검사는 AI의 문장이 임의 보상이나 보고 차단 지시로 쓰이는 일을 막는 보조 장치다.', '이는 서비스 설계 근거다. 노트의 논문이 이 정규식 정책의 효과를 검증한 것은 아니다.'],
 feel='고객 응대에 그대로 쓰기 어려운 표현을 미리 확인한다.'),
'synthesizer': dict(
 work=['승인 카드가 추가되거나 바뀐 토픽의 판단 원칙을 다시 정리한다.', '여러 카드의 이유와 금지 조건을 읽고 근거 번호가 붙은 요약을 만든다.'],
 inp=['"'`topic`: 갱신할 토픽. 예: `쿠폰·기프티콘`.'"', '"'`cards`: 해당 토픽의 승인 카드. 예: `[{id: "C003", reason: "중복 처리 방지", ...}]`.'"'],
 out=['"'`out`: 토픽 원칙을 적은 문자열. 예: `- 중복 처리를 막는다 [C003]`.'"', '"'`summary`: 갱신 요약. 예: `핵심 원칙 3개로 다시 정리`.'"'],
 rules=['승인된 해당 토픽 카드만 종합한다.', '카드가 0개이면 빈 문자열을 내고 종합을 생략한다.', 'LLM에는 공통 판단 원칙 3~5개를 요청한다. 카드 수가 부족한데 개수를 채우려고 지어내지 않는다.', '원칙마다 근거 카드 번호를 붙인다.', '규칙 모드는 판단 이유가 있는 카드의 이유 문장을 근거 번호와 함께 나열한다.'],
 no=['LLM은 여러 사례의 공통 판단을 요약한다. 새 공식규정을 만들지 않는다.', '승인 상태와 토픽별 대상 선택은 규칙이 맡는다. 요약자가 카드를 승인하지 않는다.'],
 fail=['LLM 호출 실패 시 규칙 요약을 내고 규칙 모드로 표시한다.', 'approve와 resolve에는 설정상 별도 종합 게이트 onFail이 없다.', 'record에서 card-gate에 막힌 초안을 승인 카드인 것처럼 종합하지 않는다.'],
 theory=['참고 노트 3절의 SECI 연결화는 이미 적힌 지식을 묶는 단계다.', '사건의 판단 이유를 꺼내는 표출화와 토픽 원칙을 묶는 이 역할을 구분한다.', 'Aamodt & Plaza(1994)의 Retain과도 연결해 새 사례가 다음 활용에 남도록 한다.'],
 feel='카드를 모두 읽기 전에 토픽에서 공통으로 지킬 판단 원칙을 본다.'),
'linter': dict(
 work=['카드와 질문의 관리 상태를 점검해 점장이 확인할 일을 만든다.', '수치·날짜는 규칙으로 확인하고 문장 간 상충은 LLM이나 대체 규칙으로 찾는다.'],
 inp=['"'`cards`, `questions`: 카드와 질문 목록. 예: `status: "pending"`인 카드.'"', '"'`topics`, `today`: 토픽 목록과 매장 기준일. 예: `today: "2026-10-31"`.'"'],
 out=['"'`issues`: 종류·카드 번호·설명. 예: `{kind: "만료", ids: ["C003"], detail: "만료일 경과"}`.'"', '"'`links`: 카드 관계 목록. 예: `{source: "C003", target: "C004", type: "duplicates"}`.'"'],
 rules=['expires가 기준일보다 이르면 만료다. 기준일부터 14일 이내이면 만료 임박이다.', 'uses가 3 이상이고 notHelpful가 helpful보다 크면 효과 낮음으로 표시한다.', '같은 토픽 카드의 제목·상황 유사도가 0.3을 넘으면 중복 후보로 표시한다.', '기타를 뺀 토픽의 승인 카드가 2개 미만이면 공백이다. 점장 답 대기 질문도 공백으로 모은다.', '판단 이유가 비었거나 pending 카드가 있으면 각각 이유 없음·승인 대기로 남긴다.', '상충 후보를 먼저 보여 준다. 후보 탐지는 점장의 최종 판단을 대신하지 않는다.'],
 no=['LLM은 서로 모순되는 지시를 찾는다. 만료일이나 도움 횟수를 추측하지 않는다.', '날짜·횟수·유사도 검사는 규칙이 맡는다. 카드 삭제·병합·승인은 자동 실행하지 않는다.'],
 fail=['LLM 호출 실패 시 상충 탐지도 규칙으로 바꾸고 규칙 모드로 표시한다.', 'lint 흐름에는 별도 게이트 onFail이 없다.', '검사하지 못한 부분을 문제없음으로 보고하지 않는다. 점검 결과는 점장 할 일로 남긴다.'],
 theory=['Aamodt & Plaza(1994)의 Revise와 Retain을 지식 관리에 적용한다.', '저장한 사례도 재사용 결과와 바뀐 조건에 맞춰 다시 살펴야 한다는 설계다.', '14일·3회 같은 임계값은 구현 규칙이다. 논문에서 가져온 수치는 아니다.'],
 feel='오래됐거나 서로 다른 안내를 점장이 다시 확인할 수 있다.'),
 'trainer': dict(
 work=['실제 사례의 상황을 보고 쓴 신입 답을 원래 카드와 비교한다.', '맞춘 행동과 놓친 내용을 나눠 짧게 피드백한다.'],
