 succeeded in 0ms:
// 백엔드·프론트 공통 타입. 화면과 API가 같은 모양을 보도록 여기 한 곳에서만 정의한다.

// ---------- 매장 지식 ----------

export type Source = '공식규정' | '현장노하우';
export type CardStatus = 'pending' | 'approved' | 'rejected' | 'archived';
export type CardOrigin = '시드' | '기록' | '에스컬레이션';
export type Role = '점장' | '숙련' | '신입';

export interface Person {
  id: string;
  name: string;
  role: Role;
  tenure: string; // 예: "2년차", "3일차"
}

export interface Card {
  id: string;
  title: string;
  topic: string;
  situation: string;
  reason: string; // 판단 이유 — 이 서비스의 핵심 필드
  actions: string[];
  avoid: string;
  escalateWhen: string;
  source: Source;
  authorId: string;
  status: CardStatus;
  origin: CardOrigin;
  created: string;
  updated: string;
  expires: string;
  tags: string[];
  uses: number;
  helpful: number;
  notHelpful: number;
  fromQuestionId?: string;
}

export type QuestionStatus = 'answered' | 'escalated' | 'resolved';

export interface Question {
  id: string;
  text: string;
  askerId: string;
  time: string;
  status: QuestionStatus;
  answer: string;
  why: string;
  cited: string[];
  confidence: 'high' | 'low' | 'none';
  feedback: 'solved' | 'unsolved' | null;
  managerAnswer?: string;
  cardId?: string;
  runId?: string;
}

export interface LogEntry {
  time: string;
  op: string;
  detail: string;
  runId?: string;
}

export interface StoreInfo {
  name: string;
  today: string;
}

export interface Snapshot {
  store: StoreInfo;
  topics: string[];
  people: Person[];
  cards: Card[];
  questions: Question[];
  topicSummaries: Record<string, string>;
  log: LogEntry[];
}

// ---------- 하네스 선언 ----------

export type FlowId = 'ask' | 'record' | 'approve' | 'resolve' | 'lint' | 'train';

export interface TeamDef { id: string; name: string; color: string; agents: string[] }
export interface AgentDef { id: string; team: string; name: string; role: string; card: string; llm: boolean }
export interface GateDef { id: string; flow: FlowId; agents: string[]; onFail: string }

export interface HarnessConfig {
  name: string;
  version: string;
  llm: { provider: 'anthropic'; model: string; envModel: string; fallbacks: string; offline: string };
  teams: TeamDef[];
  agents: AgentDef[];
  flows: Record<FlowId, { name: string; steps: string[] }>;
  gates: GateDef[];
}

// ---------- 실행 기록 (실시간 스트림) ----------

export type Via = 'claude' | 'rules' | 'rules(LLM 실패 대체)';
export type StepStatus = 'ok' | 'blocked' | 'skipped' | 'error';

export interface AgentStep {
  agentId: string;
  team: string;
  status: StepStatus;
  via: Via;
  ms: number;
  summary: string; // 한 줄, 화면 피드에 그대로 보인다
  problems?: string[];
}

export interface GateResult {
  gateId: string;
  passed: boolean;
  problems: string[];
  action: string;
}

// 온톨로지 그래프
export type NodeType = 'topic' | 'card' | 'person' | 'question' | 'source';
export type EdgeType =
  | 'belongs' // 카드 → 토픽
  | 'authored' // 사람 → 카드
  | 'asked' // 사람 → 질문
  | 'cites' // 질문 → 카드
  | 'became' // 질문 → (점장 답으로 생긴) 카드
  | 'governs' // 출처(공식규정/현장노하우) → 카드
  | 'conflicts'
  | 'duplicates';

export interface GraphNode {
  id: string;
  type: NodeType;
  label: string;
  sub?: string; // 보조 표시 (상태, 역할 등)
  weight?: number; // 크기 (재사용 횟수 등)
}
export interface GraphEdge { id: string; source: string; target: string; type: EdgeType }
export interface Graph { nodes: GraphNode[]; edges: GraphEdge[] }

export interface WikiChange {
  op: string; // 예: '질문 추가', '카드 승인 대기', '토픽 재종합'
  detail: string;
  nodes: GraphNode[]; // 이번에 새로 생기거나 바뀐 노드
  edges: GraphEdge[];
}

export type RunEvent =
  | { type: 'run-start'; runId: string; flow: FlowId; flowName: string; actor: string; input: string; at: string }
  | { type: 'agent-start'; runId: string; agentId: string; at: string }
  | { type: 'agent-end'; runId: string; step: AgentStep; at: string }
  | { type: 'gate'; runId: string; gate: GateResult; at: string }
  | { type: 'wiki'; runId: string; change: WikiChange; at: string }
  | { type: 'run-end'; runId: string; ok: boolean; summary: string; at: string };

export interface RunTrace {
  runId: string;
  flow: FlowId;
  startedAt: string;
  events: RunEvent[];
}

// ---------- API 응답 ----------

export interface AskResult { question: Question; candidates: { id: string; title: string; score: number }[]; runId: string }

export interface InterviewDraft {
  title: string;
  topic: string;
  situation: string;
  reason: string;
  actions: string[];
  avoid: string;
  escalateWhen: string;
  source: Source;
  tags: string[];
  followups: string[];
  masked: number; // 개인정보 가드가 가린 개수
  problems: string[]; // 표현 검증에서 걸린 것
}

export interface LintIssue { kind: '상충' | '만료' | '효과 낮음' | '공백' | '중복' | '만료 임박' | '이유 없음' | '승인 대기'; ids: string[]; detail: string }

export interface TrainingTask { id: string; topic: string; situation: string }
export interface TrainingResult { score: number; good: string[]; missing: string[]; feedback: string; card: Card }

export interface Metrics {
  cards: number;
  pending: number;
  bySource: Record<Source, number>;
  byTopic: { topic: string; n: number }[];
  questions: number;
  answeredByWiki: number;
  escalated: number;
  resolvedToCards: number;
  solvedRate: number | null;
  totalReuse: number;
  reasonCoverage: number; // 판단 이유가 채워진 카드 비율(%)
  contributors: { personId: string; name: string; cards: number; helped: number }[];
  timeline: { day: string; cards: number; questions: number }[];
}

export interface AiStatus { mode: 'claude' | 'rules'; model: string | null; lastError: string | null }
// 수집팀: 개인정보 가드 → 회고 인터뷰어 → 사례 카드 편집자
import { z } from 'zod';
import type { Source } from '@shared/contracts';
import { ask, llmEnabled } from '../harness/llm.js';
import { llmOr, type StepOut } from '../harness/runner.js';
import { maskPii } from '../tools/policies.js';
import type { CardFields } from '../store/db.js';

export interface FollowupAnswer { question: string; answer: string }

// ---------- 개인정보 가드 (규칙) ----------

export function privacyGuard(raw: string): StepOut<{ text: string; masked: number }> {
  const r = maskPii(raw);
  return { out: r, summary: r.masked ? `전화번호·카드번호·고객 이름 ${r.masked}곳을 가렸습니다` : '가릴 개인정보 없음' };
}

// ---------- 회고 인터뷰어 ----------

const REASON_RE = /(때문|이유|왜냐|해서|라서|면 안|하면|니까|므로)/;
const AVOID_RE = /(하지 않|하지 말|금지|안 된|절대)/;
const ESC_RE = /(점장|매니저|사장님께|사장님한테)/;

export const sentences = (text: string) =>
  text.split(/(?<=[.!?。])\s+|\n+|\s*->\s*|\s*→\s*/).map((s) => s.trim()).filter(Boolean);

function missingFields(raw: string) {
  const ss = sentences(raw);
  return {
    reason: !ss.some((s) => REASON_RE.test(s) && !AVOID_RE.test(s)),
    avoid: !ss.some((s) => AVOID_RE.test(s)),
    escalate: !ss.some((s) => ESC_RE.test(s)),
  };
}

const Q_REASON = '그렇게 대응한 이유가 무엇인가요? 다르게 하면 어떤 문제가 생기나요?';
const Q_AVOID = '이 방법을 쓰면 안 되는 경우나, 절대 하면 안 되는 행동이 있나요?';
const Q_ESC = '어떤 상황이면 혼자 처리하지 말고 점장을 불러야 하나요?';

export async function interviewer(raw: string, answered: boolean): Promise<StepOut<string[]>> {
  if (answered) return { out: [], summary: '되묻기 답을 받았으니 더 묻지 않습니다', status: 'skipped' };
  const { value, via } = await llmOr(
    async () =>
      (await ask('interviewer', {
        user: `[직원 기록]\n${raw}\n\n이 기록을 신입이 응용할 수 있는 사례로 만들려면 판단 이유, 하면 안 되는 것, 점장 호출 기준 중 무엇이 빠졌는지 보고, 빠진 것만 되묻는 질문을 0~2개 만들어라. 질문은 직원이 10초 안에 답할 수 있게 구체적으로.`,
        schema: z.object({ followups: z.array(z.string()) }),
      }))?.followups.slice(0, 2) ?? null,
    () => {
      const m = missingFields(raw);
      const qs = [m.reason && Q_REASON, m.avoid && Q_AVOID].filter(Boolean) as string[];
      if (qs.length < 2 && m.escalate) qs.push(Q_ESC);
      return qs.slice(0, 2);
    },
    llmEnabled(),
  );
  return { out: value, via, summary: value.length ? `빠진 내용을 ${value.length}개 되묻습니다: ${value[0]}` : '판단 이유까지 들어 있어 되묻지 않습니다' };
}

// ---------- 사례 카드 편집자 ----------

const TOPIC_KEYWORDS: Record<string, string[]> = {
  '쿠폰·기프티콘': ['쿠폰', '기프티콘', '바코드', '상품권', '할인', '멤버십'],
  '품절·대체': ['품절', '대체', '떨어', '재고', '없을'],
  '교환·환불': ['교환', '환불', '반품', '영수증'],
  '배달앱 주문': ['배달', '배민', '요기요', '쿠팡이츠', '라이더'],
  '결제·POS': ['결제', '카드', 'pos', '포스', '단말기', '승인', '현금', '페이'],
  '고객 응대': ['항의', '화를', '불만', '진상', '소리', '대기', '응대'],
};

export function guessTopic(text: string, topics: string[]): string {
  const t = text.toLowerCase();
  let best = { topic: '기타', hits: 0, first: Infinity };
  for (const [topic, kws] of Object.entries(TOPIC_KEYWORDS)) {
    if (!topics.includes(topic)) continue;
    const found = kws.map((k) => t.indexOf(k)).filter((i) => i >= 0);
    const cand = { topic, hits: found.length, first: Math.min(...found) };
    if (cand.hits > best.hits || (cand.hits === best.hits && cand.hits > 0 && cand.first < best.first)) best = cand;
  }
  return best.topic;
}

export function structureByRules(raw: string, answers: FollowupAnswer[], topics: string[]): CardFields {
  const ss = sentences(raw);
  const pick = (re: RegExp, not?: RegExp) => ss.filter((s) => re.test(s) && !(not && not.test(s)));
  let reason = pick(REASON_RE, AVOID_RE).join(' ');
  let avoid = pick(AVOID_RE).join(' ');
  let escalateWhen = pick(ESC_RE).join(' ');
  for (const { question, answer } of answers) {
    if (!answer?.trim()) continue;
    if (/이유/.test(question)) reason = [reason, answer].filter(Boolean).join(' ');
    else if (/안 되는|하면 안/.test(question)) avoid = [avoid, answer].filter(Boolean).join(' ');
    else if (/점장/.test(question)) escalateWhen = [escalateWhen, answer].filter(Boolean).join(' ');
  }
  const actions = ss.slice(1).filter((s) => !REASON_RE.test(s) && !AVOID_RE.test(s) && !ESC_RE.test(s));
  const topic = guessTopic(raw, topics);
  return {
    title: (ss[0] ?? '새 사례').replace(/[.。]$/, '').slice(0, 40),
    topic,
    situation: ss[0] ?? '',
    reason,
    actions: actions.length ? actions : ss.slice(1, 3),
    avoid,
    escalateWhen,
    source: (/(본사|규정|정책)/.test(raw) ? '공식규정' : '현장노하우') as Source,
    tags: (TOPIC_KEYWORDS[topic] ?? []).filter((k) => raw.toLowerCase().includes(k)),
  };
}

export async function cardWriter(raw: string, answers: FollowupAnswer[], topics: string[]): Promise<StepOut<CardFields>> {
  const qa = answers.filter((a) => a.answer?.trim()).map((a) => `Q: ${a.question}\nA: ${a.answer}`).join('\n');
  const schema = z.object({
    title: z.string().describe('검색하기 쉬운 상황 중심 제목, 30자 이내'),
    topic: z.enum(topics as [string, ...string[]]),
    situation: z.string(),
    reason: z.string().describe('판단 이유. 직원이 말한 근거만'),
    actions: z.array(z.string()).describe('순서대로 할 일'),
    avoid: z.string().describe('하면 안 되는 것 / 적용하면 안 되는 조건'),
    escalateWhen: z.string().describe('점장을 불러야 하는 기준'),
    source: z.enum(['공식규정', '현장노하우']),
    tags: z.array(z.string()),
  });
  const { value, via } = await llmOr(
    () => ask('card-writer', { user: `[직원 기록]\n${raw}\n${qa ? `\n[되묻기 답]\n${qa}\n` : ''}\n위 내용을 사례 카드로 구조화하라.`, schema }),
    () => structureByRules(raw, answers, topics),
    llmEnabled(),
  );
  const filled = [value.reason && '판단 이유', value.avoid && '금지', value.escalateWhen && '호출 기준'].filter(Boolean);
  return { out: value, via, summary: `'${value.title}' 카드 초안 (${value.topic}, ${value.source}) · 채운 칸: ${filled.join('·') || '대응만'}` };
}
// 검증팀: 모두 규칙. LLM이 쓴 답을 LLM이 아닌 규칙으로 확인한다.
import type { Card } from '@shared/contracts';
import type { StepOut } from '../harness/runner.js';
import { forbidden } from '../tools/policies.js';
import type { Answer } from './answer.js';

const CITE = /\[(C\d{3,})\]/g;
const HAS_CITE = /\[C\d{3,}\]/;

/** 답에 나온 카드 번호가 실제 승인 카드이고 검색 결과 안에 있는지, 근거가 하나라도 붙었는지 본다. 근거 없는 줄은 뺀다. */
export function citationChecker(ans: Answer, approvedIds: Set<string>, retrievedIds: Set<string>): StepOut<{ answer: Answer; problems: string[] }> {
  if (ans.needsManager) return { out: { answer: ans, problems: [] }, summary: '답할 카드가 없어 검사할 인용 없음', status: 'skipped' };
  const problems: string[] = [];
  const mentioned = [...ans.answer.matchAll(CITE)].map((m) => m[1]);
  for (const id of new Set([...mentioned, ...ans.cited])) {
    if (!approvedIds.has(id)) problems.push(`없는 카드 인용: ${id}`);
    else if (!retrievedIds.has(id)) problems.push(`검색되지 않은 카드 인용: ${id}`);
  }
  const lines = ans.answer.split('\n');
  const kept = lines.filter((l) => !l.trim() || HAS_CITE.test(l) || /공식규정/.test(l));
  if (kept.length < lines.length) problems.push(`근거 표시 없는 줄 ${lines.length - kept.length}개를 뺐습니다`);
  const valid = ans.cited.filter((id) => approvedIds.has(id) && retrievedIds.has(id));
  if (!valid.length) problems.push('유효한 근거 카드가 없습니다');
  const fixed: Answer = { ...ans, answer: kept.join('\n'), cited: valid };
  return { out: { answer: fixed, problems }, status: problems.length ? 'blocked' : 'ok', problems, summary: problems.length ? `인용 문제 ${problems.length}건` : `인용 ${valid.length}개 모두 실제 카드` };
}

/** 인용한 카드끼리 공식규정과 현장노하우가 같은 토픽에서 만나면, 공식규정 우선 안내가 있는지 본다. 없으면 붙인다. */
export function policyChecker(ans: Answer, cards: Card[]): StepOut<{ answer: Answer; problems: string[] }> {
  const cited = cards.filter((c) => ans.cited.includes(c.id));
  const mixed = cited.some((a) => cited.some((b) => a.topic === b.topic && a.source !== b.source));
  if (!mixed) return { out: { answer: ans, problems: [] }, summary: '공식규정과 현장노하우가 섞이지 않음' };
  if (/공식규정/.test(ans.answer)) return { out: { answer: ans, problems: [] }, summary: '규정 우선 안내 있음' };
  const official = cited.find((c) => c.source === '공식규정')!;
  const fixed = { ...ans, answer: `${ans.answer}\n공식규정 [${official.id}]과 다른 현장 관행이 있습니다. 공식규정을 따르세요. [${official.id}]` };
  return { out: { answer: fixed, problems: ['규정 우선 안내 누락 → 덧붙임'] }, status: 'blocked', problems: ['규정 우선 안내 누락'], summary: '규정 우선 안내를 덧붙였습니다' };
}

export function wordingGuard(text: string): StepOut<string[]> {
  const hits = forbidden(text).map((f) => `"${f.match}" — ${f.why}`);
  return { out: hits, status: hits.length ? 'blocked' : 'ok', problems: hits, summary: hits.length ? `금지 표현 ${hits.length}건` : '금지 표현 없음' };
}
// 위키 관리팀: 종합 편집자 · 위키 점검관 · 훈련 코치
import { z } from 'zod';
import type { Card, EdgeType, LintIssue } from '@shared/contracts';
import { ask, llmEnabled } from '../harness/llm.js';
import { llmOr, type StepOut } from '../harness/runner.js';
import { containment, similarity } from '../tools/search.js';
import * as db from '../store/db.js';

// ---------- 종합 편집자 ----------

export async function synthesizer(topic: string, cards: Card[]): Promise<StepOut<string>> {
  if (!cards.length) return { out: '', summary: `'${topic}'에 승인된 카드가 없어 종합하지 않음`, status: 'skipped' };
  const { value, via } = await llmOr(
    async () =>
      (await ask('synthesizer', {
        user: `토픽: ${topic}\n\n${cards.map((c) => `[${c.id}] ${c.title} / 이유: ${c.reason} / 금지: ${c.avoid}`).join('\n')}\n\n신입이 처음 보는 상황에서도 응용할 수 있게, 이 카드들에 공통으로 드러나는 판단 원칙 3~5개로 종합하라. 원칙마다 끝에 근거 카드 [Cxxx].`,
        schema: z.object({ principles: z.array(z.string()) }),
      }))?.principles ?? null,
    () => cards.filter((c) => c.reason).map((c) => `${c.reason.split(/(?<=[.다])\s/)[0]} [${c.id}]`),
    llmEnabled(),
  );
  return { out: value.map((p) => `- ${p}`).join('\n'), via, summary: `'${topic}' 핵심 원칙 ${value.length}개로 다시 정리` };
}

// ---------- 위키 점검관 ----------

export interface LintOut { issues: LintIssue[]; links: { source: string; target: string; type: EdgeType }[] }

function conflictsByRules(cards: Card[]) {
  const no = /(불가|안 된|하지 않|금지|필수)/;
  const yes = /(해줘도|해도 된|없이 .*(교환|환불)|그냥)/;
  const out: { ids: string[]; issue: string }[] = [];
  for (let i = 0; i < cards.length; i++)
    for (let j = i + 1; j < cards.length; j++) {
      const [a, b] = [cards[i], cards[j]];
      if (a.topic !== b.topic || a.source === b.source) continue;
      const sim = similarity(a.title + a.situation, b.title + b.situation);
      if (sim <= 0.08 || sim > 0.3) continue; // 0.3 초과는 중복으로 따로 잡는다
      const ta = a.actions.join(' ') + a.avoid + a.reason;
      const tb = b.actions.join(' ') + b.avoid + b.reason;
      if ((no.test(ta) && yes.test(tb)) || (yes.test(ta) && no.test(tb)))
        out.push({ ids: [a.id, b.id], issue: `${a.source} [${a.id}]와 ${b.source} [${b.id}]의 지시가 서로 다릅니다. 점장이 하나로 정리해야 합니다.` });
    }
  return out;
}

export async function linter(): Promise<StepOut<LintOut>> {
  const d = db.get();
  const today = db.today();
  const soon = db.addDays(today, 14);
  const approved = db.approvedCards();
  const issues: LintIssue[] = [];
  const links: LintOut['links'] = [];

  for (const c of approved) {
    if (c.expires < today) issues.push({ kind: '만료', ids: [c.id], detail: `만료일(${c.expires})이 지났습니다. 지금도 맞는지 확인하고 갱신하세요.` });
    else if (c.expires <= soon) issues.push({ kind: '만료 임박', ids: [c.id], detail: `${c.expires} 만료 예정입니다.` });
    if (c.notHelpful > c.helpful && c.uses >= 3) issues.push({ kind: '효과 낮음', ids: [c.id], detail: `'도움 안 됨'(${c.notHelpful})이 '도움 됨'(${c.helpful})보다 많습니다.` });
    if (!c.reason.trim()) issues.push({ kind: '이유 없음', ids: [c.id], detail: '판단 이유가 비어 있어 신입이 응용하기 어렵습니다.' });
  }
  for (let i = 0; i < approved.length; i++)
    for (let j = i + 1; j < approved.length; j++) {
      const [a, b] = [approved[i], approved[j]];
      if (a.topic === b.topic && similarity(a.title + a.situation, b.title + b.situation) > 0.3) {
        issues.push({ kind: '중복', ids: [a.id, b.id], detail: '비슷한 상황을 다루는 카드입니다. 하나로 합치면 검색이 정확해집니다.' });
        links.push({ source: a.id, target: b.id, type: 'duplicates' });
      }
    }

  const { value: conflicts, via } = await llmOr(
    async () =>
      (await ask('linter', {
        user: `같은 토픽의 카드들이다. 서로 모순되는 지시(한쪽은 하라, 한쪽은 하지 말라)만 찾아라. 단순 중복은 제외.\n\n${approved.map((c) => `[${c.id}] (${c.topic}, ${c.source}) ${c.title} / 대응: ${c.actions.join(' / ')} / 금지: ${c.avoid}`).join('\n')}`,
        schema: z.object({ conflicts: z.array(z.object({ ids: z.array(z.string()), issue: z.string() })) }),
      }))?.conflicts ?? null,
    () => conflictsByRules(approved),
    llmEnabled(),
  );
  for (const c of conflicts) {
    issues.push({ kind: '상충', ids: c.ids, detail: c.issue });
    if (c.ids.length >= 2) links.push({ source: c.ids[0], target: c.ids[1], type: 'conflicts' });
  }

  const waiting = d.questions.filter((q) => q.status === 'escalated');
  if (waiting.length) issues.push({ kind: '공백', ids: waiting.map((q) => q.id), detail: `위키가 답하지 못한 질문 ${waiting.length}건이 점장 답을 기다립니다. 답하면 사례로 쌓입니다.` });
  for (const topic of d.topics.filter((t) => t !== '기타')) {
    const n = approved.filter((c) => c.topic === topic).length;
    if (n < 2) issues.push({ kind: '공백', ids: [], detail: `'${topic}' 토픽 사례가 ${n}개뿐입니다. 숙련 직원에게 회고를 요청하세요.` });
  }
  const pending = d.cards.filter((c) => c.status === 'pending');
  if (pending.length) issues.push({ kind: '승인 대기', ids: pending.map((c) => c.id), detail: `승인 대기 사례 ${pending.length}건` });

  const order: LintIssue['kind'][] = ['상충', '만료', '효과 낮음', '공백', '중복', '만료 임박', '이유 없음', '승인 대기'];
  issues.sort((a, b) => order.indexOf(a.kind) - order.indexOf(b.kind));
  const count = (k: LintIssue['kind']) => issues.filter((i) => i.kind === k).length;
  return { out: { issues, links }, via, summary: `할 일 ${issues.length}건 (상충 ${count('상충')}, 만료 ${count('만료')}, 중복 ${count('중복')}, 공백 ${count('공백')})` };
}

// ---------- 훈련 코치 ----------

export interface Grade { score: number; good: string[]; missing: string[]; feedback: string }

export async function trainer(c: Card, userAnswer: string): Promise<StepOut<Grade>> {
  const { value, via } = await llmOr(
    () =>
      ask('trainer', {
        user: `[정답 카드]\n${c.title}\n대응: ${c.actions.join(' / ')}\n이유: ${c.reason}\n금지: ${c.avoid}\n\n[신입 답]\n${userAnswer}\n\n핵심 행동, 판단 이유 이해, 금지 행동 회피를 보고 0~100점으로 채점하라. 격려하는 말투로 짧게.`,
        schema: z.object({ score: z.number().int(), good: z.array(z.string()), missing: z.array(z.string()), feedback: z.string() }),
      }),
    () => {
      const good = c.actions.filter((a) => containment(a, userAnswer) >= 0.3);
      const missing = c.actions.filter((a) => !good.includes(a));
      const score = Math.round((good.length / Math.max(c.actions.length, 1)) * 100);
      return { score, good, missing, feedback: score >= 60 ? '핵심 대응을 잘 짚었어요. 판단 이유도 함께 기억해 두세요.' : '놓친 대응이 있어요. 카드의 판단 이유를 먼저 읽어 보세요.' };
    },
    llmEnabled(),
  );
  return { out: value, via, summary: `${value.score}점 · 맞춘 행동 ${value.good.length}/${c.actions.length}` };
}
// 답변팀: 검색 사서 → 현장 코치 → (검증팀) → 점장 연결
import { z } from 'zod';
import type { Card } from '@shared/contracts';
import { ask, llmEnabled } from '../harness/llm.js';
import { llmOr, type StepOut } from '../harness/runner.js';
import { containment, search, type Hit } from '../tools/search.js';

export interface Answer {
  answer: string;
  why: string;
  cited: string[];
  confidence: 'high' | 'low' | 'none';
  needsManager: boolean;
}

// ---------- 검색 사서 (규칙) ----------

export function librarian(question: string, cards: Card[]): StepOut<Hit[]> {
  const hits = search(question, cards);
  return {
    out: hits,
    summary: hits.length ? `가까운 사례 ${hits.length}개: ${hits.slice(0, 3).map((h) => `${h.card.id}(${h.score.toFixed(1)})`).join(', ')}` : '가까운 사례를 찾지 못했습니다',
  };
}

// ---------- 현장 코치 ----------

const NO_ANSWER = '매장 위키에 이 상황에 맞는 사례가 아직 없습니다. 점장님께 질문을 넘겼어요. 답이 오면 위키에 사례로 추가됩니다.';

export function answerByRules(hits: Hit[]): Answer {
  const top = hits[0];
  if (!top || top.score < 3 || top.coverage < 0.25) return { answer: NO_ANSWER, why: '', cited: [], confidence: 'none', needsManager: true };
  // 같은 상황을 다룬 공식규정 카드가 비슷한 점수로 있으면 그쪽을 앞세운다.
  const official = hits.find((h) => h.card.source === '공식규정' && h.card.topic === top.card.topic && h.score >= top.score * 0.8);
  const ordered = official && official !== top ? [official, ...hits.filter((h) => h !== official)] : hits;
  const c = ordered[0].card;
  const lines = [`${c.title} [${c.id}]`, ...c.actions.map((a, i) => `${i + 1}. ${a} [${c.id}]`)];
  if (c.avoid) lines.push(`하지 말 것: ${c.avoid} [${c.id}]`);
  if (c.escalateWhen) lines.push(`점장 호출: ${c.escalateWhen} [${c.id}]`);
  const other = ordered.slice(1).find((h) => h.card.topic === c.topic && h.card.source !== c.source && h.score > top.score * 0.6);
  const cited = [c.id];
  if (other) {
    lines.push(`같은 토픽의 ${other.card.source} 카드 [${other.card.id}]도 있습니다. 내용이 다르면 공식규정을 따르세요.`);
    cited.push(other.card.id);
  }
  return { answer: lines.join('\n'), why: c.reason, cited, confidence: top.score > 6 ? 'high' : 'low', needsManager: false };
}

export async function coach(question: string, hits: Hit[]): Promise<StepOut<Answer>> {
  const context = hits
    .map(({ card: c }) => `[${c.id}] (${c.source}, 갱신 ${c.updated}) ${c.title}\n상황: ${c.situation}\n판단 이유: ${c.reason}\n대응: ${c.actions.join(' / ')}\n하면 안 되는 것: ${c.avoid || '-'}\n점장 호출 기준: ${c.escalateWhen || '-'}`)
    .join('\n\n');
  const schema = z.object({
    answer: z.string().describe('신입이 지금 바로 따라 할 3~5줄. 줄마다 끝에 근거 카드 [Cxxx]'),
    why: z.string().describe('이렇게 하는 이유 한두 문장(카드의 판단 이유에서)'),
    cited: z.array(z.string()),
    confidence: z.enum(['high', 'low', 'none']),
    needsManager: z.boolean(),
  });
  const { value, via } = await llmOr(
    () =>
      hits.length
        ? ask('coach', {
            user: `[사례 카드]\n${context}\n\n[신입의 질문]\n${question}\n\n카드에 있는 내용만 근거로 답하라. 카드에 없는 정책·금액·절차를 추측하지 마라. 공식규정과 현장노하우가 부딪히면 공식규정을 따르라고 적어라. 카드로 답할 수 없으면 confidence는 none, needsManager는 true.`,
            schema,
            effort: 'medium',
          })
        : Promise.resolve({ answer: NO_ANSWER, why: '', cited: [], confidence: 'none' as const, needsManager: true }),
    () => answerByRules(hits),
    llmEnabled(),
  );
  return { out: value, via, summary: value.needsManager ? '카드로 답할 수 없다고 판단' : `답변 작성 (근거 ${value.cited.join(', ')}, 확신 ${value.confidence})` };
}

// ---------- 점장 연결 (규칙) ----------

export function escalator(question: string, ans: Answer, gatePassed: boolean, cards: Card[]): StepOut<{ escalate: boolean; note: string }> {
  if (ans.needsManager || ans.confidence === 'none') return { out: { escalate: true, note: '근거 카드 없음' }, summary: '점장에게 넘겼습니다 (근거 카드 없음)' };
  if (!gatePassed && !ans.cited.length) return { out: { escalate: true, note: '검증을 통과한 문장 없음' }, summary: '점장에게 넘겼습니다 (검증 통과 문장 없음)' };
  const hit = cards.find((c) => ans.cited.includes(c.id) && c.escalateWhen && containment(c.escalateWhen, question) >= 0.35);
  if (hit) return { out: { escalate: false, note: `점장 호출 기준 해당 가능: ${hit.escalateWhen}` }, summary: `답은 주되 호출 기준을 강조 ([${hit.id}])` };
  return { out: { escalate: false, note: '' }, summary: '위키 답으로 충분합니다' };
}

