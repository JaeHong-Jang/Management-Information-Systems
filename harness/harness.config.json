{
  "name": "이어받기 매장 위키 에이전트 하네스",
  "version": "0.3.0",
  "llm": {
    "provider": "anthropic",
    "model": "claude-opus-5-5",
    "envModel": "CLAUDE_MODEL",
    "fallbacks": "default",
    "offline": "ANTHROPIC_API_KEY가 없거나 호출이 실패하면 규칙 기반으로 같은 모양의 결과를 낸다. 화면에 '규칙 모드'로 표시한다.",
    "ollama": { "model": "ax4-light:q4_K_M", "envModel": "OLLAMA_MODEL", "envHost": "OLLAMA_HOST" }
  },
  "teams": [
    { "id": "lead", "name": "지휘", "color": "blue", "agents": ["orchestrator"] },
    { "id": "capture", "name": "수집팀", "color": "green", "agents": ["privacy-guard", "interviewer", "card-writer"] },
    { "id": "answer", "name": "답변팀", "color": "violet", "agents": ["librarian", "coach", "escalator"] },
    { "id": "verify", "name": "검증팀", "color": "orange", "agents": ["citation-checker", "policy-checker", "wording-guard"] },
    { "id": "keeper", "name": "위키 관리팀", "color": "teal", "agents": ["synthesizer", "linter"] },
    { "id": "stock", "name": "재고팀", "color": "ink", "agents": ["pos-reader", "recipe-writer", "demand-analyst", "order-clerk"] }
  ],
  "agents": [
    { "id": "orchestrator", "team": "lead", "name": "오케스트레이터", "role": "들어온 요청을 흐름(질문·기록·점장 답변·점검·재고)에 배정하고 실행 순서와 결과 요약을 맡는다", "card": "agents/lead/orchestrator.md", "llm": false },
    { "id": "privacy-guard", "team": "capture", "name": "개인정보 가드", "role": "기록 속 전화번호·카드번호·고객 실명을 가린다. 가린 개수를 남긴다", "card": "agents/capture/privacy-guard.md", "llm": false },
    { "id": "interviewer", "team": "capture", "name": "회고 인터뷰어", "role": "무엇을 했는지만 적힌 기록에서 빠진 판단 이유·하면 안 되는 것·점장 호출 기준을 되묻는다", "card": "agents/capture/interviewer.md", "llm": true },
    { "id": "card-writer", "team": "capture", "name": "사례 카드 편집자", "role": "기록과 되묻기 답을 상황·판단 이유·대응·금지·호출 기준의 사례 카드로 정리한다", "card": "agents/capture/card-writer.md", "llm": true },
    { "id": "librarian", "team": "answer", "name": "검색 사서", "role": "승인된 사례 카드에서 질문과 가까운 카드를 찾는다(한국어 2-gram BM25)", "card": "agents/answer/librarian.md", "llm": false },
    { "id": "coach", "team": "answer", "name": "현장 코치", "role": "찾은 카드만 근거로 신입이 바로 따라 할 답을 쓴다. 문장마다 카드 번호를 붙인다", "card": "agents/answer/coach.md", "llm": true },
    { "id": "escalator", "team": "answer", "name": "점장 연결", "role": "근거가 없거나 점장 호출 기준에 걸리면 점장에게 넘긴다", "card": "agents/answer/escalator.md", "llm": false },
    { "id": "citation-checker", "team": "verify", "name": "근거 검증", "role": "답의 문장마다 실제 승인된 카드 번호가 붙었는지, 없는 카드를 인용하지 않았는지 본다", "card": "agents/verify/citation-checker.md", "llm": false },
    { "id": "policy-checker", "team": "verify", "name": "규정 우선 검증", "role": "인용한 카드끼리 공식규정과 현장노하우가 부딪히면 공식규정을 따르라는 안내가 있는지 본다", "card": "agents/verify/policy-checker.md", "llm": false },
    { "id": "wording-guard", "team": "verify", "name": "표현 검증", "role": "고객 탓, 단정, 임의 보상 약속 같은 금지 표현을 막는다", "card": "agents/verify/wording-guard.md", "llm": false },
    { "id": "synthesizer", "team": "keeper", "name": "종합 편집자", "role": "토픽에 카드가 늘거나 바뀌면 토픽 페이지의 핵심 판단 원칙을 다시 쓴다", "card": "agents/keeper/synthesizer.md", "llm": true },
    { "id": "linter", "team": "keeper", "name": "위키 점검관", "role": "상충·만료·효과 낮음·중복·빈 토픽·승인 대기를 찾아 점장 할 일로 만든다", "card": "agents/keeper/linter.md", "llm": true },
    { "id": "pos-reader", "team": "stock", "name": "POS 정리원", "role": "POS 매출 CSV에서 날짜·메뉴·수량을 뽑고 처음 보는 메뉴를 찾는다", "card": "agents/stock/pos-reader.md", "llm": false },
    { "id": "recipe-writer", "team": "stock", "name": "레시피 편집자", "role": "처음 보는 메뉴의 재료 소모량 초안을 만든다. 점장이 승인해야 사용량에 들어간다", "card": "agents/stock/recipe-writer.md", "llm": true },
    { "id": "demand-analyst", "team": "stock", "name": "수요 분석가", "role": "요일별 평균 사용량을 계산하고, 다가오는 매장 일정과 승인된 재고 카드로 보정 배수를 제안한다", "card": "agents/stock/demand-analyst.md", "llm": true },
    { "id": "order-clerk", "team": "stock", "name": "발주 담당", "role": "발주점에 닿는 품목을 거래처별 주문서 초안으로 만들고, 질문에 재고 숫자를 붙인다", "card": "agents/stock/order-clerk.md", "llm": false }
  ],
  "flows": {
    "ask": { "name": "신입 질문", "steps": ["orchestrator", "privacy-guard", "librarian", "order-clerk", "coach", "citation-checker", "policy-checker", "wording-guard", "escalator"] },
    "record": { "name": "노하우 기록", "steps": ["orchestrator", "privacy-guard", "interviewer", "card-writer", "wording-guard"] },
    "approve": { "name": "점장 승인", "steps": ["orchestrator", "synthesizer"] },
    "resolve": { "name": "점장 답변 재축적", "steps": ["orchestrator", "privacy-guard", "card-writer", "wording-guard", "synthesizer"] },
    "lint": { "name": "위키 점검", "steps": ["orchestrator", "linter"] },
    "pos": { "name": "POS 판매 반영", "steps": ["orchestrator", "pos-reader", "recipe-writer", "demand-analyst", "citation-checker", "order-clerk"] },
    "stocktake": { "name": "마감 재고 실사", "steps": ["orchestrator", "order-clerk", "linter"] },
    "stockapprove": { "name": "재고 승인·입고", "steps": ["orchestrator", "order-clerk"] }
  },
  "gates": [
    { "id": "answer-gate", "flow": "ask", "agents": ["citation-checker", "policy-checker", "wording-guard"], "onFail": "근거 없는 문장을 빼고 다시 확인한다. 남는 문장이 없으면 점장에게 넘긴다" },
    { "id": "card-gate", "flow": "record", "agents": ["wording-guard"], "onFail": "막힌 표현을 표시하고 작성자에게 고쳐 달라고 되돌린다(저장은 승인 대기로)" },
    { "id": "adjust-gate", "flow": "pos", "agents": ["citation-checker"], "onFail": "승인 카드를 인용하지 않았거나 카드에 없는 배수를 쓴 보정 제안은 버린다" }
  ]
}
