{
  "note": "현장 코치의 답과 사례 카드에서 막는 표현. pattern은 정규식, why는 화면에 보이는 이유.",
  "rules": [
    {
      "id": "blame-customer",
      "pattern": "(고객|손님)(이|가)?\\s*(잘못|틀렸|거짓말|진상)",
      "why": "고객 탓을 하는 표현은 응대 지침으로 남기지 않는다"
    },
    {
      "id": "absolute-refund",
      "pattern": "무조건\\s*(환불|교환|무료)",
      "why": "보상 범위를 단정하면 정산·규정 문제가 생긴다"
    },
    {
      "id": "free-promise",
      "pattern": "(공짜|무료)로\\s*(드리|줘|준다)",
      "why": "임의 무료 제공은 점장 승인 대상이다"
    },
    {
      "id": "always-never",
      "pattern": "(항상|절대로)\\s*(된다|됩니다|안 된다|안됩니다)",
      "why": "예외를 지우는 단정은 판단을 막는다. 조건을 함께 적는다"
    },
    {
      "id": "ai-certainty",
      "pattern": "(100%|확실히|틀림없이)",
      "why": "AI 답이 확실하다고 말하지 않는다"
    },
    {
      "id": "hide-from-manager",
      "pattern": "(점장|사장)(님)?(한테|에게|께)\\s*(말하지|알리지)\\s*(마|말)",
      "why": "보고를 막는 지시는 남기지 않는다"
    }
  ],
  "pii": [
    {
      "id": "phone",
      "pattern": "01[016789][-\\s]?\\d{3,4}[-\\s]?\\d{4}",
      "mask": "[전화번호]"
    },
    {
      "id": "card",
      "pattern": "\\d{4}[-\\s]?\\d{4}[-\\s]?\\d{4}[-\\s]?\\d{4}",
      "mask": "[카드번호]"
    },
    {
      "id": "customer-name",
      "pattern": "([가-힣]{2,3})\\s*(고객|손님)님",
      "mask": "[고객]"
    }
  ],
  "alwaysEscalate": {
    "note": "질문에 이런 말이 있으면 위키가 답하지 않고 바로 점장에게 넘긴다. 카드 호출 기준의 글자 일치를 보완하는 안전망.",
    "rules": [
      {
        "id": "health",
        "pattern": "(알레르기|알러지|두드러기|가렵|숨(을|이)? ?(못|차|막)|호흡|쓰러|어지러|토했|구토|기절|의식)",
        "why": "고객 건강 이상"
      },
      {
        "id": "injury",
        "pattern": "(다쳤|다쳐|다침|피가|피 나|화상|데었|베였|넘어졌|미끄러)",
        "why": "부상"
      },
      {
        "id": "violence",
        "pattern": "(폭행|때리|때렸|때릴|밀쳤|밀치|멱살|욕설|욕을|위협|협박|소리 ?지르며 ?다가)",
        "why": "폭력·위협"
      },
      {
        "id": "emergency",
        "pattern": "(화재|불이 ?났|불났|연기가|가스 ?냄새|정전|누전|물이 ?새)",
        "why": "시설 위급"
      },
      {
        "id": "crime",
        "pattern": "(도난|훔쳐|훔쳤|절도|성희롱|추행|몰카|경찰)",
        "why": "범죄 의심"
      }
    ]
  }
}